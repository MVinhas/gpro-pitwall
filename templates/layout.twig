{% import "partials/_localtime.twig" as t %}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Per-page SEO. Pages override these blocks; the defaults describe the
       homepage. Keep titles ≤ 60 chars (front-load the search keywords) and
       descriptions ≤ 160 chars. #}
    {% set default_title = 'GPRO Setup Calculator & Race Strategy Planner — GPRO Pitwall' %}
    {% set default_description = 'Free GPRO strategy tool: setup calculator, race strategy planner, car wear analysis, fuel & tyre forecasts, training planner and driver market analyzer for Grand Prix Racing Online.' %}
    <title>{% block title %}{{ default_title }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ default_description }}{% endblock %}">
    {% block robots %}{% endblock %}
    <link rel="canonical" href="{{ canonical_host }}{% block canonical_path %}/{% endblock %}">
    <meta name="theme-color" content="#142f4d">

    <meta property="og:site_name" content="GPRO Pitwall">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_host }}{{ block('canonical_path') }}">
    <meta property="og:image" content="{{ canonical_host }}/assets/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="{{ canonical_host }}/assets/og-image.png">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/logo.svg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {# Theme boot: apply the stored appearance before first paint (no flash).
       Absent/invalid value = System, which pure CSS color-scheme handles. #}
    <script>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
    {# Version query enables long-lived asset caching (see .htaccess) while
       guaranteeing every release busts the client cache. #}
    <link rel="stylesheet" href="/assets/app.css?v={{ app_version }}">
    {% block structured_data %}{% endblock %}
</head>

<body class="h-full font-sans text-slate-800 antialiased">
<div class="min-h-full">

    {# HEADER — one bar: the mark on the left, account actions on the right. The
       brand is not a heading: every page carries its own h1. #}
    <header class="bg-surface border-b border-slate-200">
        <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4">
            <a href="/" class="flex shrink-0 items-center gap-2 hover:opacity-80">
                <img src="/logo.svg" alt="" class="h-7 w-7 shrink-0" width="28" height="28">
                <span class="text-base font-bold text-slate-900"><span class="text-blue-600">GPRO</span> Pitwall</span>
            </a>

            <div class="flex items-center gap-3 text-sm sm:gap-5">
                {% if is_logged_in %}
                    {% if user.is_admin %}
                        <details class="relative" data-header-menu>
                            <summary class="cursor-pointer list-none font-medium text-slate-600 hover:text-slate-900">Admin</summary>
                            <div class="card absolute right-0 z-50 mt-2 w-44 py-1 shadow-lg">
                                <a href="/admin/users" class="block px-4 py-2 text-slate-700 hover:bg-slate-50">Users</a>
                                <a href="/admin/telemetry" class="block px-4 py-2 text-slate-700 hover:bg-slate-50">Corpus</a>
                                <a href="/debug" class="block px-4 py-2 text-slate-700 hover:bg-slate-50">Debug</a>
                            </div>
                        </details>
                    {% endif %}
                    <a href="/control_panel" class="font-medium text-slate-600 hover:text-slate-900">Account</a>
                    <form method="POST" action="/logout">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="font-medium text-slate-600 hover:text-slate-900">Log out</button>
                    </form>
                {% else %}
                    <a href="/login" class="font-medium text-slate-600 hover:text-slate-900">Log in</a>
                    <a href="/register" class="btn btn-sm btn-primary">Register</a>
                {% endif %}
            </div>
        </div>
    </header>

    {% if is_logged_in %}
    {# STATUS LINE — where the data stands (sync, API budget) and the team facts
       every screen leans on. sync_state (App\Support\SyncState) is the same
       source the Account page reads, so the two never disagree. #}
    {# Calm when the data is current; the whole line takes the caution / failure
       tone when a new race weekend has opened since the last sync, or the sync
       failed — planning on last weekend's car is the costliest silent mistake. #}
    {% set sync_alarm = sync_state == 'failed' ? 'failed' : ((sync_state == 'synced' and sync_stale) ? 'stale' : '') %}
    <div class="border-b {{ sync_alarm == 'failed' ? 'border-red-200 bg-red-50' : (sync_alarm == 'stale' ? 'border-amber-200 bg-amber-50' : 'border-slate-200 bg-slate-50') }}">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-1.5 px-4 py-1.5 text-xs text-slate-600">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                {% if sync_state == 'running' %}
                    <span>Syncing GPRO data…</span>
                {% elseif sync_state == 'failed' %}
                    <span class="font-semibold text-red-800">Sync failed — data may be out of date</span>
                {% elseif sync_state == 'deferred' %}
                    <span class="font-medium text-amber-700" title="GPRO API budget low. It'll resume once your hourly allowance recovers.">Sync paused — API budget low</span>
                {% elseif sync_state == 'synced' and sync_stale %}
                    <span class="font-semibold text-amber-800">Synced before this race weekend · {{ t.localtime(user.last_synced_at, 'datetime') }}</span>
                {% elseif sync_state == 'synced' %}
                    <span>Synced {{ t.localtime(user.last_synced_at, 'datetime') }}</span>
                {% elseif sync_state == 'never' %}
                    <span>Not synced yet</span>
                {% elseif sync_state == 'no_token' %}
                    <a href="/control_panel" class="font-medium text-blue-600 hover:underline">Add your GPRO API token</a>
                {% endif %}
                {% if can_submit and sync_state != 'no_token' %}
                    <button id="apiWarmupBtn" type="button" class="btn btn-primary whitespace-nowrap px-2.5 py-1 text-xs">
                        <svg id="apiWarmupSpinner" class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" aria-hidden="true">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
                        </svg>
                        <svg id="apiWarmupIcon" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 11a8 8 0 0 0-14.9-3M4 4v4h4m-4 5a8 8 0 0 0 14.9 3M20 20v-4h-4"/></svg>
                        <span id="apiWarmupText">Re-sync</span>
                    </button>
                {% endif %}
                {% if api_limit is defined and api_limit != '?' %}
                    {# Quiet while healthy; takes the caution / failure tone only when low. #}
                    {% set api_tone = (api_limit < 20) ? 'font-semibold text-red-700'
                                      : ((api_limit < 50) ? 'font-semibold text-amber-700' : 'text-slate-600') %}
                    {% set api_age = api_limit_updated_at
                        ? ' · checked ' ~ ((('now'|date('U')) - api_limit_updated_at) // 60) ~ 'm ago'
                        : '' %}
                    {% set api_tip = (api_limit < 50)
                        ? 'Few API calls left this race weekend — avoid hard-refreshing data; the cache keeps recent answers warm for you.' ~ api_age
                        : 'GPRO API calls remaining for this race.' ~ api_age %}
                    <span class="cursor-help tabular-nums {{ api_tone }}" title="{{ api_tip }}">{{ api_limit|number_format }} API calls left</span>
                {% endif %}
            </div>

            {# Built by the billboard() Twig function (bootstrap.php) so it
               renders on every signed-in page, cache-only. #}
            {% set strip = billboard() %}
            {% if strip %}
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 tabular-nums">
                <span{% if strip.cash_rank %} class="cursor-help" title="#{{ strip.cash_rank }} of {{ strip.cash_total }} by cash in {{ strip.division ?? 'your group' }}"{% endif %}>
                    <span class="hidden text-slate-500 sm:inline">Cash</span>
                    <span class="font-medium text-slate-900">${{ strip.cash|number_format(0, '.', ',') }}</span>
                </span>
                {% if strip.division %}
                <span>
                    <span class="hidden text-slate-500 sm:inline">Division</span>
                    <span class="font-medium text-slate-900">{{ strip.division }}</span>
                </span>
                {% endif %}
                {% if strip.next_track %}
                <span>
                    <span class="text-slate-500">Next</span>
                    <span class="font-medium text-slate-900">{{ strip.next_track }}</span>
                    {% if strip.season and strip.race %}
                        <span class="text-slate-500">S{{ strip.season }} R{{ strip.race }}</span>
                    {% endif %}
                </span>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <main>
        <div class="mx-auto max-w-7xl px-4 pt-4 pb-8">
            {% block content %}{% endblock %}
        </div>
    </main>

    <footer class="px-4 py-6">
        <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 text-xs text-slate-500 lg:flex-row lg:justify-between">
            <p class="text-center lg:text-left">
                &copy; {{ "now"|date("Y") }} GPRO Pitwall {{ app_version }} · Unofficial fan tool, not affiliated with
                <a href="https://www.gpro.net" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-blue-600">Grand Prix Racing Online</a>
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
                <a href="https://github.com/MVinhas/gpro-pitwall" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-blue-600">Source</a>
                <a href="https://github.com/MVinhas/gpro-pitwall/issues" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-blue-600">Report an issue</a>
                {% if is_logged_in %}
                    <a href="/contact" class="font-medium hover:text-blue-600">Send feedback</a>
                {% else %}
                    <a href="mailto:admin@gpro-pitwall.com" class="font-medium hover:text-blue-600">Contact me</a>
                {% endif %}
                <a href="https://buymeacoffee.com/mvinhas" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1 font-medium text-amber-600 hover:text-amber-700"
                   title="If Pitwall saved your race weekend, buy me a coffee">
                    <span aria-hidden="true">☕</span>
                    <span>Buy me a coffee</span>
                </a>
                <div id="themePicker" hidden role="group" aria-label="Appearance"
                     class="inline-flex items-center gap-0.5 rounded-lg bg-slate-200/60 p-0.5">
                    <button type="button" data-set-theme="light" aria-pressed="false" aria-label="Light theme" title="Light"
                            class="rounded-md p-1 text-slate-500 hover:text-slate-700">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                    <button type="button" data-set-theme="dark" aria-pressed="false" aria-label="Dark theme" title="Dark"
                            class="rounded-md p-1 text-slate-500 hover:text-slate-700">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.4 14.5A8.5 8.5 0 0 1 9.5 3.6a8.5 8.5 0 1 0 10.9 10.9z"/></svg>
                    </button>
                    <button type="button" data-set-theme="system" aria-pressed="false" aria-label="Match system theme" title="System"
                            class="rounded-md p-1 text-slate-500 hover:text-slate-700">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path stroke-linecap="round" d="M8 20h8m-4-4v4"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </footer>
</div>


<script>
document.getElementById('apiWarmupBtn')?.addEventListener('click', async function () {
    const btn = this;
    const spinner = document.getElementById('apiWarmupSpinner');
    const text = document.getElementById('apiWarmupText');
    const icon = document.getElementById('apiWarmupIcon');

    btn.disabled = true;
    icon.classList.add('hidden');
    spinner.classList.remove('hidden');
    text.textContent = 'Re-syncing…';

    try {
        const res = await fetch('/api/warmup', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest'},
            body: new URLSearchParams({ csrf_token: '{{ csrf_token }}' })
        });
        if (res.status === 401 || res.status === 403) {
            window.location = '/login?expired=1';
            return;
        }
        const data = await res.json();
        text.textContent = data.message || (data.success ? 'Done' : 'Sync failed');
        // Reload so the freshly-synced data shows on the current tab.
        if (data.status === 'synced') {
            setTimeout(() => window.location.reload(), 800);
        }
    } catch {
        text.textContent = 'Network error';
    }

    setTimeout(() => {
        btn.disabled = false;
        spinner.classList.add('hidden');
        icon.classList.remove('hidden');
        text.textContent = 'Re-sync';
    }, 3000);
});

// Header menus (Admin) are native <details>: close an open one when the click
// lands anywhere outside it, as a menu is expected to.
document.addEventListener('click', (e) => {
    document.querySelectorAll('details[data-header-menu][open]').forEach((menu) => {
        if (!menu.contains(e.target)) menu.open = false;
    });
});

// Single-submit guard: any form tagged data-disable-on-submit disables every
// submit button inside it the moment the form is submitted. Prevents the
// double-click problem on slow endpoints (verify, register, login_request).
document.addEventListener('submit', (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.hasAttribute('data-disable-on-submit')) return;
    form.querySelectorAll('button[type="submit"], input[type="submit"]').forEach((btn) => {
        btn.disabled = true;
        btn.classList.add('opacity-60', 'cursor-not-allowed');
        const busyText = btn.dataset.busyText;
        if (busyText && btn.tagName === 'BUTTON') {
            btn.textContent = busyText;
        }
    });
}, true);
</script>

<script>
// Accordion open-state persistence: any <details data-acc> with an id keeps
// the user's open/closed choice in sessionStorage for the session. Fragment
// swaps re-render each accordion with its server-side default, so every
// innerHTML-swap handler calls applyAccState(root) to restore the choice.
// First visit (no stored state): ≥1024px viewports open accordions flagged
// data-acc-lg-open; everything else keeps its server-rendered state.
// Only a click on the summary is stored — never a programmatic or
// parser-set open — so a card the server opened because it needs attention
// is not remembered as open once the problem is gone.
(() => {
    const key = (id) => 'acc:' + id;
    window.applyAccState = (root) => {
        (root || document).querySelectorAll('details[data-acc][id]').forEach((el) => {
            const saved = sessionStorage.getItem(key(el.id));
            if (saved !== null) {
                el.open = saved === '1';
            } else if (el.dataset.accLgOpen !== undefined && matchMedia('(min-width: 1024px)').matches) {
                el.open = true;
            }
        });
    };
    // Keyboard activation of a <summary> dispatches click too. The click runs
    // before the toggle, so the stored value is the state it is about to take.
    document.addEventListener('click', (e) => {
        const summary = e.target instanceof Element ? e.target.closest('summary') : null;
        const details = summary ? summary.parentElement : null;
        if (!(details instanceof HTMLDetailsElement) || !details.hasAttribute('data-acc') || !details.id) return;
        if (summary !== details.querySelector(':scope > summary')) return;
        sessionStorage.setItem(key(details.id), details.open ? '0' : '1');
    });
    window.applyAccState(document);
})();
</script>

<script>
// Local-time rendering: timestamps are stored and emitted as UTC. Rewrite every
// <time data-localtime> into the visitor's own timezone via Intl, so a user in
// any zone sees their local time. No-JS users keep the server-rendered UTC text.
(() => {
    const PRESETS = {
        datetime: { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' },
        date:     { month: 'short', day: 'numeric', year: 'numeric' },
        day:      { month: 'short', day: 'numeric' },
    };
    document.querySelectorAll('time[data-localtime]').forEach((el) => {
        const iso = el.getAttribute('datetime');
        if (!iso) return;
        const d = new Date(iso);
        if (isNaN(d)) return;
        const opts = PRESETS[el.dataset.localtime] || PRESETS.datetime;
        try {
            el.textContent = new Intl.DateTimeFormat(undefined, opts).format(d);
        } catch (_) {
            // Leave the UTC fallback in place if Intl formatting fails.
        }
    });
})();
</script>

<script>
// Appearance picker: Light/Dark pin a theme via data-theme + localStorage;
// System clears both and lets color-scheme follow the OS. The control only
// appears when JS runs — without JS the site still follows the OS theme.
(() => {
    const picker = document.getElementById('themePicker');
    if (!picker) return;
    const ACTIVE = ['bg-surface', 'text-slate-900'];
    const paint = (choice) => {
        picker.querySelectorAll('[data-set-theme]').forEach((btn) => {
            const on = btn.dataset.setTheme === choice;
            btn.setAttribute('aria-pressed', String(on));
            ACTIVE.forEach((c) => btn.classList.toggle(c, on));
        });
    };
    const stored = () => {
        try { return localStorage.getItem('theme') || 'system'; } catch { return 'system'; }
    };
    picker.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-set-theme]');
        if (!btn) return;
        const choice = btn.dataset.setTheme;
        try {
            if (choice === 'system') localStorage.removeItem('theme');
            else localStorage.setItem('theme', choice);
        } catch {}
        if (choice === 'system') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = choice;
        paint(choice);
    });
    paint(stored());
    picker.hidden = false;
})();
</script>

</body>
</html>
