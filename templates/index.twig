{% extends 'layout.twig' %}

{% block content %}
    {# Navigation Bar #}
    {% include 'partials/_nav.twig' %}

    {# The active tab already names the screen visually; the page heading is for
       assistive tech and the document outline. #}
    <h1 class="sr-only">{{ {'Race Strategy': 'Race strategy', 'Training Planner': 'Training planner', 'Recruitment Analyzer': 'Recruitment', 'Division Baseline': 'Division baseline', 'Division Differences': 'Division differences', 'Cockpit': 'Race weekend cockpit', 'Car Wear Planner': 'Car wear planner'}[active_main_tab]|default(active_main_tab) }}</h1>

    {# Main Content Area #}
    <div id="main-content-tabs"{% if deferred_url is defined %} data-deferred="{{ deferred_url }}" aria-busy="true"{% endif %}>
        {% if deferred_url is defined %}
            {# Skeleton first: the real screen is fetched from deferred_url and
               swapped in by the script below. #}
            <p class="sr-only" role="status">Loading your GPRO data…</p>
            <p data-slow hidden class="mb-3 text-xs text-slate-500">Fetching your latest data from GPRO…</p>
            {% include 'partials/_skeleton.twig' with {tab: active_main_tab} only %}
            <template data-load-error>
                <div class="notice notice-error">
                    <span class="font-bold">Couldn't load this screen.</span>
                    <a href="{{ deferred_url }}" class="underline">Try again</a>
                </div>
            </template>
            <noscript>
                <meta http-equiv="refresh" content="0; url={{ deferred_url }}">
                <a href="{{ deferred_url }}" class="text-sm font-medium text-blue-600 hover:underline">Load this screen</a>
            </noscript>

        {% elseif active_main_tab == 'Cockpit' %}
            {% include 'partials/_tab_cockpit.twig' %}

        {% elseif active_main_tab == 'Recruitment Analyzer' %}
            {% include 'partials/_tab_recruitment.twig' %}
        
        {% elseif active_main_tab == 'Training Planner' %}
            {% include 'partials/_tab_training.twig' %}

        {% elseif active_main_tab == 'Division Baseline' %}
            {% include 'partials/_tab_baseline.twig' %}
        
        {% elseif active_main_tab == 'Division Differences' %}
            {% include 'partials/_tab_differences.twig' %}
            
        {% elseif active_main_tab == 'Race Strategy' %}
            {% include 'partials/_tab_strategy.twig' %}

        {% elseif active_main_tab == 'Car Wear Planner' %}
            {% include 'partials/_tab_car_wear.twig' %}

        {% elseif active_main_tab == 'Testing' %}
            {% include 'partials/_tab_testing.twig' %}

        {% endif %}
    </div>

    {% if deferred_url is defined %}
    <script>
    // Fill the skeleton: fetch the real screen and swap it, and the status line
    // (the sync it may have just run changes both), into this page.
    (() => {
        const host = document.getElementById('main-content-tabs');
        const slow = setTimeout(() => host.querySelector('[data-slow]')?.removeAttribute('hidden'), 4000);

        const fail = () => {
            const tpl = host.querySelector('template[data-load-error]');
            host.removeAttribute('aria-busy');
            host.replaceChildren(tpl ? tpl.content.cloneNode(true) : '');
        };

        // Parsed scripts never run; re-create each so the screen wires itself up.
        const runScripts = (root) => root.querySelectorAll('script').forEach((old) => {
            const fresh = document.createElement('script');
            for (const a of old.attributes) fresh.setAttribute(a.name, a.value);
            fresh.textContent = old.textContent;
            old.replaceWith(fresh);
        });

        fetch(host.dataset.deferred, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(async (res) => {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                const next = doc.getElementById('main-content-tabs');
                // Auth lapsed or the account lost its token: go where the server sent us.
                if (!next || next.hasAttribute('data-deferred')) {
                    window.location.assign(res.redirected ? res.url : window.location.href);
                    return;
                }
                const status = doc.getElementById('statusLine');
                if (status) document.getElementById('statusLine')?.replaceWith(status);

                [...next.children].forEach((el, i) => {
                    el.classList.add('reveal');
                    el.style.animationDelay = Math.min(i, 4) * 50 + 'ms';
                });
                host.replaceWith(next);
                runScripts(next);
                window.applyAccState?.(next);
                window.localizeTimes?.(document);
            })
            .catch(fail)
            .finally(() => clearTimeout(slow));
    })();
    </script>
    {% endif %}
{% endblock %}
