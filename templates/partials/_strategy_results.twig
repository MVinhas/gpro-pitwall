{# One state at a time, in precedence order. An error always wins over a
   stored result: a failed recalculation must never sit on top of the previous
   success. Expected outcomes (season over, no tyre supplier) are not failures,
   so they take the caution tone; only the generic load failure is an error. #}
{% if strategy_error == no_pilot_message %}
    <div data-result-state="no-driver">{% include 'partials/_no_pilot_notice.twig' %}</div>
{% elseif strategy_error == generic_error_message %}
    <div class="notice notice-error" data-result-state="failed">
        <p class="font-bold">Strategy calculation failed.</p>
        <p class="mt-1">{{ strategy_error }}</p>
    </div>
{% elseif strategy_error %}
    <div class="notice notice-warn" data-result-state="unavailable">
        <span class="font-bold">Strategy unavailable.</span> {{ strategy_error }}
    </div>
{% elseif strategy_results and strategy_results.error is defined %}
    <div class="notice notice-warn" data-result-state="unavailable">
        <span class="font-bold">Strategy unavailable.</span> {{ strategy_results.error }}
    </div>
{% elseif strategy_results and strategy_results.track is defined %}
    {% set sr = strategy_results %}
    {% set best = sr.tyres[sr.best_compound] %}
    {% set ra = sr.risk_advice is defined ? sr.risk_advice : null %}
    {# Runner-up must be the same tyre type as the winner: dry compares
       against dry only; Rain (wet) has no same-type rival, so no line. #}
    {% set runner_name = null %}
    {% if sr.best_compound != 'Rain' %}
        {% for comp, data in sr.tyres %}
            {% if comp != 'Rain' and comp != sr.best_compound and (runner_name is null or data.total_lost < sr.tyres[runner_name].total_lost) %}
                {% set runner_name = comp %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {# GPRO's own setup field names, in GPRO's order. #}
    {% set parts = {'Front Wing': 'Front wing', 'Rear Wing': 'Rear wing', 'Engine': 'Engine', 'Brakes': 'Brakes', 'Gearbox': 'Gear', 'Suspension': 'Suspension'} %}
    {% set sessions = [
        {key: 'Q1', temp: sr.weather_inputs.Q1.temp, weather: sr.weather_inputs.Q1.weather},
        {key: 'Q2', temp: sr.weather_inputs.Q2.temp, weather: sr.weather_inputs.Q2.weather},
        {key: 'Race', temp: sr.inputs.temp, weather: sr.weather_inputs.Race.weather},
    ] %}

    <div class="space-y-6" data-result-state="results">

        {# RACE SHEET — the values the manager types into GPRO, in GPRO's own form
           order: setup, fuel, tyres, risks, boost laps. Start risk and pit-on-problem
           are deliberately left out: they don't work well in the game (Micael).
           Sessions are rows and parts are columns, so all three setups fit a phone
           without scrolling sideways. #}
        <section class="card" aria-labelledby="race-sheet-title">
            <div class="bg-board px-4 py-3 sm:px-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <div>
                    <h3 id="race-sheet-title" class="text-[10px] font-semibold uppercase tracking-wide text-white/60">Race sheet</h3>
                    <p class="text-base font-semibold text-white">
                        {{ sr.track }}
                        <span class="text-xs font-normal text-white/60 tabular-nums">Season {{ sr.season }} · Race {{ sr.race }} · {{ sr.inputs.laps }} laps</span>
                    </p>
                </div>
                <label class="flex items-center gap-2 whitespace-nowrap text-xs text-white/60">
                    Race weather
                    <select form="stratForm" name="race_weather" data-strategy-fragment-trigger class="form-select w-24 text-xs">
                        <option value="Dry" {{ sr.weather_inputs.Race.weather == 'Dry' ? 'selected' }}>Dry</option>
                        <option value="Wet" {{ sr.weather_inputs.Race.weather == 'Wet' ? 'selected' }}>Wet</option>
                    </select>
                </label>
            </div>

            {# Parts are rows and sessions are columns — the same top-to-bottom order as
               GPRO's setup form, so each value is typed straight across. The rest of the
               race settings sit beside it on wide screens. #}
            <div class="grid lg:grid-cols-2">
            <div class="px-2 py-3 sm:px-4">
                <table class="w-full text-sm">
                    <caption class="sr-only">Car setup for each session</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="pb-1.5 pl-2 pr-2 text-left align-bottom t-label font-medium">Setup</th>
                            {% for s in sessions %}
                                <th scope="col" class="pb-1.5 pl-4 pr-2 text-right align-bottom sm:pl-6">
                                    <span class="block text-sm font-semibold text-slate-900">{{ s.key }}</span>
                                    <span class="block text-xs font-normal text-slate-500 whitespace-nowrap">{{ s.temp }}° {{ s.weather }}</span>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    {# Alternate shading keeps each part's row distinct while the eye
                       travels down one session's column. #}
                    <tbody>
                        {% for key, label in parts %}
                            <tr class="odd:bg-slate-100/70">
                                <th scope="row" class="rounded-l-md py-2 pl-2 pr-2 text-left font-normal text-slate-700 whitespace-nowrap">{{ label }}</th>
                                {% for s in sessions %}
                                    {% set v = sr.setups[s.key][key] %}
                                    <td class="py-2 pl-4 pr-2 text-right font-semibold text-slate-900 tabular-nums last:rounded-r-md sm:pl-6">
                                        {# GPRO caps every setup field at 999: show what to enter,
                                           and keep the computed value visible beside it. #}
                                        {% if v > 999 %}999<span class="block text-[10px] font-normal text-slate-400" title="Computed {{ v }} — GPRO accepts at most 999">{{ v }}</span>{% else %}{{ v }}{% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <dl class="grid grid-cols-2 content-start gap-x-6 gap-y-3 border-t border-slate-200 px-4 py-4 sm:grid-cols-3 sm:px-6 lg:grid-cols-2 lg:border-t-0 lg:border-l">
                <div>
                    <dt class="t-label">Fuel per stint</dt>
                    <dd class="text-base font-semibold text-slate-900 tabular-nums">{{ best.fuel_recommended }} L</dd>
                </div>
                <div>
                    <dt class="t-label">Tyres</dt>
                    <dd class="text-base font-semibold text-slate-900">{{ sr.best_compound }} <span class="text-sm font-normal text-slate-500">· {{ best.stops }} stop{{ best.stops == 1 ? '' : 's' }}</span></dd>
                </div>
                {% if ra %}
                    <div>
                        <dt class="t-label">Overtake risk</dt>
                        <dd class="text-base font-semibold text-slate-900 tabular-nums">{{ ra.overtake }}</dd>
                    </div>
                    <div>
                        <dt class="t-label">Defend risk</dt>
                        <dd class="text-base font-semibold text-slate-900 tabular-nums">{{ ra.defend }}</dd>
                    </div>
                {% endif %}
                <div>
                    <dt class="t-label">Clear track risk</dt>
                    <dd class="text-base font-semibold text-slate-900 tabular-nums">{{ sr.inputs.risk ?? 0 }}</dd>
                </div>
                {% if ra and ra.boost is defined %}
                    {# Only the sets the fuel plan carries (Boost stints); suggestions
                       beyond that would under-fuel the car, so they stay a hint. #}
                    {% set planned = ra.boost.planned|default([]) %}
                    <div>
                        <dt class="t-label">Boost laps</dt>
                        {% if planned is not empty %}
                            <dd class="text-base font-semibold text-slate-900 tabular-nums">{{ planned|join(' · ') }}</dd>
                        {% else %}
                            <dd class="text-base font-semibold text-slate-900">Off</dd>
                            {% if ra.boost.laps is not empty %}
                                <dd class="text-xs text-slate-500 tabular-nums">suggested {{ ra.boost.laps|join(' · ') }}</dd>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endif %}
            </dl>
            </div>
            {# PUSH SIGNALS — the evidence for the Clear Track Risk above: one short fact
               per signal, tinted when it holds. The long explanation is the chip's title. #}
            {% if sr.push_signals is defined %}
                {% set ps = sr.push_signals %}
                {% set signals = [
                    {ok: ps.pha_match,
                     short: ps.pha_level == 'perfect' ? 'Perfect P/H/A match' : (ps.pha_level == 'top' ? 'Top P/H/A match' : 'No P/H/A match'),
                     detail: ps.pha_level == 'perfect' ? 'All three attributes line up with the track.' : (ps.pha_level == 'top' ? 'Your strongest attribute is what the track demands most.' : 'Your car is built for different attributes than this track rewards.')},
                    {ok: ps.favourite,
                     short: ps.favourite ? 'Favourite track' : 'Not a favourite track',
                     detail: ps.favourite ? "One of your driver's three favourite tracks." : "Not one of your driver's favourite tracks."},
                ] %}
                {% if ps.show_tyres %}
                    {% set signals = signals|merge([
                        {ok: ps.tyres_weather,
                         short: ps.tyre_perf is null ? 'No tyre rating' : ((ps.race_wet ? 'Wet' : 'Dry') ~ ' tyres ' ~ ps.tyre_perf ~ '/8'),
                         detail: ps.tyre_perf is null ? 'No tyre supplier rating available.' : ('Supplier ' ~ (ps.race_wet ? 'wet' : 'dry') ~ ' rating ' ~ ps.tyre_perf ~ '/8; 4/8 or better counts.')},
                        {ok: ps.temp_match,
                         short: ps.ideal_temp is null ? 'No ideal temp' : ('Track ' ~ ps.race_temp ~ '° vs ideal ' ~ ps.ideal_temp ~ '°'),
                         detail: 'Race temperature within ±3°C of the tyre ideal counts.'},
                    ]) %}
                {% endif %}
                {% if ps.car_rank is not null %}
                    {% set signals = signals|merge([{ok: ps.car_above, short: 'Car #' ~ ps.car_rank ~ ' of ' ~ ps.car_total, detail: 'Car level against the group; above the group average counts.'}]) %}
                {% endif %}
                {% if ps.driver_rank is not null %}
                    {% set signals = signals|merge([{ok: ps.driver_above, short: 'Driver #' ~ ps.driver_rank ~ ' of ' ~ ps.driver_total, detail: 'Driver OA against the group; above the group average counts.'}]) %}
                {% endif %}
                {% if ps.wear_ok is not null %}
                    {% set signals = signals|merge([{ok: ps.wear_ok, short: 'Worst part ' ~ ps.wear_max|number_format(0) ~ '% at CTR ' ~ ps.wear_risk, detail: 'The car can take the push while its worst part stays under 90% wear.'}]) %}
                {% endif %}
                {% set met = signals|filter(x => x.ok)|length %}
                <div class="border-t border-slate-200 bg-slate-50 px-4 py-3 sm:px-6">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <p class="t-label">Push signals <span class="ml-1 text-slate-900 tabular-nums">{{ met }} of {{ signals|length }}</span></p>
                        {% embed 'partials/_how.twig' %}{% block how %}
                            <p>Each signal that holds argues for a higher Clear Track Risk; a full sweep points to a very likely win. Heuristic guidance from your car, driver, track and forecast — not a game formula.</p>
                        {% endblock %}{% endembed %}
                    </div>
                    <ul class="mt-2 flex flex-wrap gap-1.5">
                        {% for x in signals %}
                            <li class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs {{ x.ok ? 'bg-emerald-100 font-medium text-emerald-800' : 'bg-slate-100 text-slate-500' }}" title="{{ x.detail }}">
                                <span aria-hidden="true">{{ x.ok ? '✓' : '–' }}</span>{{ x.short }}<span class="sr-only">{{ x.ok ? ' — holds' : " — doesn't hold" }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </section>

        {# TYRE COMPARISON — why the sheet picked this compound. #}
        <section class="card" aria-labelledby="tyre-comparison-title">
            <div class="card-hd space-y-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 id="tyre-comparison-title" class="t-section">Tyre comparison</h3>
                    <p class="text-xs text-slate-600 tabular-nums">
                        {{ sr.best_compound }} loses {{ best.total_lost }}s{% if runner_name is not null %} — {{ (sr.tyres[runner_name].total_lost - best.total_lost)|round(1) }}s less than {{ runner_name }}{% endif %}
                    </p>
                </div>
                <p class="flex flex-wrap gap-x-4 gap-y-1 text-xs tabular-nums">
                    <span><span class="text-slate-500">Supplier</span> <span class="text-slate-900">{{ sr.supplier }}</span>
                        {% if sr.supplier_info %}{% set si = sr.supplier_info %}<span class="text-slate-500" title="Your tyre supplier's characteristics — not the track.">({% if si.dry is not null %}dry {{ si.dry }}/8{% endif %}{% if si.wet is not null %}, wet {{ si.wet }}/8{% endif %}{% if si.temp is not null %}, ideal {{ si.temp }}°C{% endif %})</span>{% endif %}
                    </span>
                    <span><span class="text-slate-500">Consumption</span> <span class="text-slate-900">{{ sr.fuel.l_per_lap }} L/lap</span></span>
                    <span><span class="text-slate-500">Race fuel</span> <span class="text-slate-900">{{ sr.fuel.dry }} L dry · {{ sr.fuel.wet }} L wet</span>{% if sr.fuel.wet_estimated %} <span class="font-semibold text-amber-700" title="This track has never run a wet race, so there is no measured wet consumption. The wet figure assumes dry consumption — safe, but over-fuelled.">est.</span>{% endif %}</span>
                    {% if sr.overtaking %}
                        <span title="How easily cars pass here. Hard overtaking makes track position more valuable — favour fewer pit stops."><span class="text-slate-500">Overtaking</span> <span class="text-slate-900">{{ sr.overtaking }}</span></span>
                    {% endif %}
                </p>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th rowspan="2" class="px-3 sm:px-4 py-2 text-left text-[10px] font-semibold uppercase tracking-wide text-slate-500">Compound</th>
                            <th rowspan="2" class="px-2 sm:px-4 py-2 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-500">Stops</th>
                            <th colspan="2" class="hidden sm:table-cell px-4 pt-2 text-center text-[10px] font-semibold uppercase tracking-wide text-slate-500">Fuel / stint (L)</th>
                            <th class="sm:hidden px-2 pt-2 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-500">Fuel (L)</th>
                            <th rowspan="2" class="hidden md:table-cell px-2 py-2 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-500">Est. pit (s)</th>
                            <th colspan="4" class="hidden md:table-cell px-2 pt-2 text-center text-[10px] font-semibold uppercase tracking-wide text-slate-500 border-l border-slate-200">Time lost (s)</th>
                            {% if sr.ctr_gain_per_lap > 0 %}
                                <th rowspan="2" class="hidden sm:table-cell px-2 py-2 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-500" title="The most your Clear Track Risk can save, in clear air only. Stuck behind another car you wear the tyres harder without banking the time.">CTR max gain</th>
                            {% endif %}
                            <th rowspan="2" class="px-2 sm:px-4 py-2 text-right text-[10px] font-semibold uppercase tracking-wide text-slate-700 border-l border-slate-200">{{ sr.ctr_gain_per_lap > 0 ? 'Net' : 'Total lost' }}</th>
                        </tr>
                        <tr>
                            <th class="hidden sm:table-cell px-2 pb-2 text-right text-[10px] font-medium uppercase tracking-wide text-slate-400" title="Bare-minimum litres of fuel to finish the stint; no safety margin.">Minimum</th>
                            <th class="px-2 pb-2 text-right text-[10px] font-medium uppercase tracking-wide text-slate-400" title="Litres to put in the car: the minimum plus one extra lap's worth, as a buffer against bad pit timing.">Recommended</th>
                            <th class="hidden md:table-cell px-2 pb-2 text-right text-[10px] font-medium uppercase tracking-wide text-slate-400 border-l border-slate-200">Pits</th>
                            <th class="hidden md:table-cell px-2 pb-2 text-right text-[10px] font-medium uppercase tracking-wide text-slate-400">Fuel</th>
                            <th class="hidden md:table-cell px-2 pb-2 text-right text-[10px] font-medium uppercase tracking-wide text-slate-400">TCD</th>
                            <th class="hidden md:table-cell px-2 pb-2 text-right text-[10px] font-medium uppercase tracking-wide text-slate-400">Total</th>
                        </tr>
                    </thead>
                    <tbody class="bg-surface divide-y divide-slate-200">
                        {% for comp, data in sr.tyres %}
                            {% set is_best = (comp == sr.best_compound) %}
                            <tr class="{{ is_best ? 'bg-emerald-50' : '' }}"{% if is_best %} aria-current="true"{% endif %}>
                                <th scope="row" class="px-3 sm:px-4 py-2.5 text-left font-semibold text-slate-900">{{ comp }}</th>
                                <td class="px-2 sm:px-4 py-2.5 text-right text-slate-900">{{ data.stops }}</td>
                                <td class="hidden sm:table-cell px-2 py-2.5 text-right text-slate-500">{{ data.fuel_load }}</td>
                                <td class="px-2 py-2.5 text-right text-slate-900">{{ data.fuel_recommended }}</td>
                                <td class="hidden md:table-cell px-2 py-2.5 text-right text-slate-500">{{ data.pit_time_est }}</td>
                                <td class="hidden md:table-cell px-2 py-2.5 text-right text-xs text-slate-500 border-l border-slate-100">{{ data.lost_pits }}</td>
                                <td class="hidden md:table-cell px-2 py-2.5 text-right text-xs text-slate-500">{{ data.lost_fuel }}</td>
                                <td class="hidden md:table-cell px-2 py-2.5 text-right text-xs text-slate-500">{{ data.lost_tcd }}</td>
                                <td class="hidden md:table-cell px-2 py-2.5 text-right text-xs text-slate-500">{{ data.total_lost }}</td>
                                {% if sr.ctr_gain_per_lap > 0 %}
                                    <td class="hidden sm:table-cell px-2 py-2.5 text-right text-xs {{ data.ctr_gain > 0 ? 'text-slate-700' : 'text-slate-400' }}">{{ data.ctr_gain > 0 ? '−' ~ data.ctr_gain ~ 's' : '—' }}</td>
                                {% endif %}
                                <td class="px-2 sm:px-4 py-2.5 text-right font-semibold text-slate-900 border-l border-slate-200">{{ data.net_lost }}s</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if sr.fuel.wet_estimated %}
                <div class="px-4 py-3 sm:px-6 border-t border-slate-200">
                    <div class="notice notice-warn notice-slim">
                        <strong>Wet fuel is an estimate.</strong> This track has never run a wet race, so the wet figures assume dry consumption and will over-fuel you rather than strand you.
                    </div>
                </div>
            {% endif %}
        </section>

        {# Peak-end support ask: it renders only once a strategy has actually been
           calculated — the one screen where Pitwall has just answered the question
           the user came for. Yellow on purpose (Micael, 2026-09-13). #}
        <div class="support-strip">
            <p class="support-strip-copy">
                <span aria-hidden="true" class="text-base leading-none">☕</span>
                <span>
                    <strong class="font-semibold">Strategy sorted.</strong>
                    Pitwall is free and always will be — a coffee keeps it running.
                </span>
            </p>
            <a href="https://buymeacoffee.com/mvinhas" target="_blank" rel="noopener noreferrer"
               class="btn btn-sm btn-coffee shrink-0">Buy me a coffee</a>
        </div>
    </div>
{% else %}
    <div class="h-full flex flex-col items-center justify-center bg-slate-50 rounded-xl border border-dashed border-slate-200 p-12" data-result-state="empty">
        <p class="t-heading">Strategy &amp; Setup</p>
        <p class="t-caption mt-1">No strategy calculated yet.</p>
    </div>
{% endif %}
