{# The four ranges a manager reaches for first stay on screen; the rest of the
   attributes sit one click away. #}
{% set primary_fields = ['OA', 'AGE', 'SAL', 'FEE'] %}
{% set more_active = range_filters|filter((r, f) => f not in primary_fields)|length %}

{% macro range(field, label, ranges, wide) %}
    {% set r = ranges[field] ?? {} %}
    <fieldset class="min-w-0{{ wide ? ' col-span-2 sm:col-span-1' : '' }}">
        <legend class="t-label mb-1">{{ label }}</legend>
        <div class="flex items-center gap-1.5">
            <input type="number" name="min_{{ field }}" value="{{ r.min ?? '' }}" min="0" step="1" inputmode="numeric"
                   placeholder="Min" aria-label="{{ label }} minimum" class="form-input min-w-0 tabular-nums">
            <span class="text-slate-400" aria-hidden="true">–</span>
            <input type="number" name="max_{{ field }}" value="{{ r.max ?? '' }}" min="0" step="1" inputmode="numeric"
                   placeholder="Max" aria-label="{{ label }} maximum" class="form-input min-w-0 tabular-nums">
        </div>
    </fieldset>
{% endmacro %}

<div class="space-y-6">
    <div class="card">
        <div class="card-hd flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <h2 class="t-section">Recruitment</h2>
                <p class="t-caption">Drivers on the GPRO market, scored against your target division's ideal driver.</p>
                <p class="t-caption">Drivers decide Mondays and Thursdays at 18:00 (Lisbon); offers rise from 10:00 the same days.</p>
            </div>
            <form method="POST" action="/recruitment/refresh" class="flex shrink-0 items-center gap-3">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                {% if recruitment_updated_at|default('') %}
                    <span class="t-caption">Market updated {{ recruitment_updated_at }}</span>
                {% endif %}
                <button type="submit" class="btn btn-sm btn-secondary" title="Pull the latest market from GPRO">
                    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.1 15a7 7 0 0 0 12.9 2M18.9 9A7 7 0 0 0 6 7"/></svg>
                    Refresh
                </button>
            </form>
        </div>

        {# Every change applies at once (script below); without JS the noscript
           button submits the same GET. #}
        <form id="recruitFilters" method="GET" action="/recruitment" class="card-bd flex flex-col gap-5">
            <input type="hidden" name="sort" value="{{ sort.col }}">
            <input type="hidden" name="order" value="{{ sort.order }}">

            <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between">
                <fieldset class="min-w-0">
                    <legend class="t-label mb-1.5">Target division</legend>
                    <div class="seg-radio">
                        {% for div in divisions %}
                            <label>
                                <input type="radio" name="division_tab" value="{{ div }}" {{ div == active_division ? 'checked' }}>
                                {{ div }}
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>

                <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-700 sm:pb-2">
                    <input type="checkbox" name="no_offers" value="1" {{ hide_offers ? 'checked' }}
                           class="h-4 w-4 rounded-md border-slate-300 text-blue-600 focus:ring-blue-500">
                    Hide drivers with offers
                </label>
            </div>

            <div class="grid grid-cols-2 gap-x-4 gap-y-3 lg:grid-cols-4">
                {% for field in primary_fields %}
                    {{ _self.range(field, range_filter_fields[field], range_filters, field in ['SAL', 'FEE']) }}
                {% endfor %}
            </div>

            <details class="group rounded-lg border border-slate-200" data-more-filters {{ more_active > 0 ? 'open' }}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-4 py-2.5">
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
                        More attributes
                        <span class="brief-chip" data-more-count {{ more_active > 0 ? '' : 'hidden' }}>{{ more_active }} active</span>
                    </span>
                    <svg class="size-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="grid grid-cols-2 gap-x-4 gap-y-3 border-t border-slate-200 p-4 sm:grid-cols-3 lg:grid-cols-5">
                    {% for field, label in range_filter_fields %}
                        {% if field not in primary_fields %}
                            {{ _self.range(field, label, range_filters, false) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </details>

            <noscript>
                <div class="flex justify-end">
                    <button type="submit" class="btn btn-md btn-primary">Apply filters</button>
                </div>
            </noscript>
        </form>
    </div>

    <p id="recruitment-status" class="sr-only" role="status"></p>
    <div id="recruitment-results" class="transition-opacity">
        {% include 'partials/_recruitment_results.twig' %}
    </div>
</div>

<script>
(() => {
    const form = document.getElementById('recruitFilters');
    const host = document.getElementById('recruitment-results');
    if (!form || !host) return;
    const status = document.getElementById('recruitment-status');
    const more = form.querySelector('[data-more-filters]');

    // Empty boxes are "no bound": leave them out so URLs stay short.
    const fromForm = () => {
        const params = new URLSearchParams(new FormData(form));
        for (const [key, value] of [...params]) if (value === '') params.delete(key);
        return params;
    };

    const countMore = () => {
        const badge = more?.querySelector('[data-more-count]');
        if (!badge) return;
        const fields = new Set([...more.querySelectorAll('input')].filter((el) => el.value !== '').map((el) => el.name.slice(4)));
        badge.textContent = fields.size + ' active';
        badge.hidden = fields.size === 0;
    };

    // A chip, sort header or page link changes the settings outside the form;
    // mirror them back so the next edit starts from what is on screen.
    const syncForm = (params) => {
        for (const el of form.elements) {
            if (!el.name) continue;
            if (el.type === 'radio' || el.type === 'hidden') {
                if (!params.has(el.name)) continue;
                if (el.type === 'radio') el.checked = params.get(el.name) === el.value;
                else el.value = params.get(el.name);
            } else if (el.type === 'checkbox') {
                el.checked = params.get(el.name) === el.value;
            } else {
                el.value = params.get(el.name) ?? '';
            }
        }
        countMore();
    };

    const pageUrl = (params) => {
        const url = new URL(window.location.href);
        url.search = params.toString();
        url.hash = '';
        return url;
    };

    // While a request is in flight the previous results stay on screen,
    // dimmed; a failure keeps them (their chips still describe them) and
    // says so above them, with a retry.
    const setBusy = (on) => {
        host.setAttribute('aria-busy', on ? 'true' : 'false');
        host.classList.toggle('opacity-60', on);
    };
    const showFailure = () => {
        host.querySelector('[data-load-failed]')?.remove();
        const box = document.createElement('div');
        box.className = 'notice notice-error mb-4 flex flex-wrap items-center justify-between gap-2';
        box.dataset.loadFailed = '';
        const text = document.createElement('p');
        text.innerHTML = '<span class="font-bold">Couldn\'t update the results.</span> Showing the previous ones.';
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'btn btn-sm btn-secondary';
        retry.textContent = 'Try again';
        retry.addEventListener('click', () => load(fromForm(), 'replace', true));
        box.append(text, retry);
        host.prepend(box);
        if (status) status.textContent = 'Couldn\'t update the results.';
    };

    let pending = null;
    let shown = fromForm().toString();

    const load = async (params, history = 'replace', force = false) => {
        countMore();
        // Re-applying what is already on screen spends nothing.
        if (!force && params.toString() === shown) return;
        if (pending) pending.abort();
        const request = new AbortController();
        pending = request;
        const page = pageUrl(params);
        const fetchUrl = new URL(page);
        fetchUrl.searchParams.set('fragment', 'recruitment_results');
        setBusy(true);
        try {
            const res = await fetch(fetchUrl, { signal: request.signal, headers: { 'X-Requested-With': 'fetch' } });
            // Session lapsed: a full load re-signs in from the remember-me cookie.
            if (res.redirected || res.status === 401 || res.status === 403) {
                window.location.assign(page);
                return;
            }
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const html = await res.text();
            // A whole document means something other than the fragment answered.
            if (/<!doctype/i.test(html)) {
                window.location.assign(page);
                return;
            }
            host.innerHTML = html;
            shown = params.toString();
            if (history === 'push') window.history.pushState(null, '', page);
            else if (history === 'replace') window.history.replaceState(null, '', page);
            window.localizeTimes?.(host);
            if (status) status.textContent = (host.querySelector('[data-results-count]')?.textContent ?? '').replace(/\s+/g, ' ').trim();
        } catch (err) {
            if (err.name === 'AbortError') return;
            console.error(err);
            showFailure();
        } finally {
            if (pending === request) setBusy(false);
        }
    };

    // Radios and the checkbox commit on click; number boxes on blur or Enter.
    form.addEventListener('change', () => load(fromForm()));
    form.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || e.target.type !== 'number') return;
        e.preventDefault();
        load(fromForm());
    });
    form.addEventListener('submit', (e) => {
        e.preventDefault();
        load(fromForm());
    });

    host.addEventListener('click', (e) => {
        const link = e.target.closest('a[data-recruit-nav]');
        if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        const params = new URL(link.href).searchParams;
        syncForm(params);
        load(params, 'push');
        if (link.dataset.recruitNav === 'page') host.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    window.addEventListener('popstate', () => {
        if (window.location.pathname !== '/recruitment') return;
        const params = new URLSearchParams(window.location.search);
        syncForm(params);
        load(params, 'none');
    });
})();
</script>
