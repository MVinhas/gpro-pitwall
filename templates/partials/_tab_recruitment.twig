<div class="space-y-6">
    <div class="card">
        {# Header Section #}
        <div class="card-hd flex flex-col sm:flex-row justify-between items-start sm:items-center">
            <div>
                <h2 class="t-section">Recruitment analyzer</h2>
                <p class="t-caption">Score the live GPRO driver market against your division's ideal driver.</p>
                <p class="t-caption">Drivers decide Mondays and Thursdays at 18:00 (Lisbon); offers rise from 10:00 the same days.</p>
            </div>
        </div>

        <div class="card-bd">
            <form method="POST" action="/analyze_recruitment" class="space-y-6">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                {% if recruitment_updated_at %}
                    <p class="t-caption">Market updated {{ recruitment_updated_at }}.</p>
                {% endif %}

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
                    {# Target Division #}
                    <div>
                        <label class="t-label block mb-1">Target division</label>
                        <select name="target_division" class="form-select">
                            {% for div in divisions %}
                                <option value="{{ div }}" {{ div == active_division ? 'selected' : '' }}>{{ div }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Filters #}
                    <div class="pb-2">
                        <label class="inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="filter_offers" value="1" class="rounded-md border-slate-300 text-blue-600 focus:ring-blue-500 h-4 w-4">
                            <span class="ml-2 text-sm text-slate-700">Exclude drivers with offers</span>
                        </label>
                    </div>

                    {# Force a fresh market pull (bypasses cache). #}
                    <div class="pb-2">
                        <label class="inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="refresh_market" value="1" class="rounded-md border-slate-300 text-blue-600 focus:ring-blue-500 h-4 w-4">
                            <span class="ml-2 text-sm text-slate-700">Re-fetch market now</span>
                        </label>
                    </div>
                </div>

                <div class="flex justify-end border-t border-slate-100 pt-6">
                    <button type="submit" class="btn btn-md btn-primary">
                        Analyze candidates
                    </button>
                </div>
            </form>

            {# Results Section #}
            {% if recruitment_error %}
                <div class="mt-6 notice notice-error">
                    <p class="font-bold">Analysis failed.</p>
                    <p class="mt-1">{{ recruitment_error }}</p>
                </div>
            {% elseif recruitment_results is defined %}
                <div class="mt-8">
                    <div class="flex justify-between items-end mb-4">
                        <h3 class="t-section">
                            {{ pagination.total_items }} candidate{{ pagination.total_items == 1 ? '' : 's' }}
                            {% if range_filters|length > 0 %}
                                <span class="t-caption font-medium">of {{ recruitment_unfiltered_total }}</span>
                            {% endif %}
                        </h3>
                        <span class="t-caption tabular-nums">
                            {% if pagination.total_pages > 0 %}
                                Page {{ pagination.current }} of {{ pagination.total_pages }}
                            {% else %}
                                No matching candidates
                            {% endif %}
                        </span>
                    </div>

                    {% set hasRangeFilters = range_filters|length > 0 %}
                    <details class="mb-4 rounded-lg border border-slate-200 bg-slate-50 group" {{ hasRangeFilters ? 'open' : '' }}>
                        <summary class="flex items-center justify-between px-4 py-3 cursor-pointer list-none">
                            <span class="text-sm font-medium text-slate-700">Value range filters</span>
                            <span class="inline-flex items-center gap-2">
                                {% if hasRangeFilters %}
                                    <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">
                                        {{ range_filters|length }} active {{ range_filters|length == 1 ? 'range' : 'ranges' }}
                                    </span>
                                {% endif %}
                                <svg class="size-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                            </span>
                        </summary>

                        <form method="GET" action="/" class="border-t border-slate-200 bg-surface px-4 py-4">
                            <input type="hidden" name="main_tab" value="Recruitment Analyzer">
                            <input type="hidden" name="division_tab" value="{{ active_division }}">
                            <input type="hidden" name="sort" value="{{ sort.col }}">
                            <input type="hidden" name="order" value="{{ sort.order }}">


                            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
                                {% for field, label in range_filter_fields %}
                                    <div class="rounded-md border border-slate-200 p-3">
                                        <span class="t-label block mb-2">{{ label }}</span>
                                        <div class="grid grid-cols-2 gap-2">
                                            <div>
                                                <label for="min-{{ field }}" class="t-caption block mb-1">Minimum</label>
                                                <input type="number"
                                                       id="min-{{ field }}"
                                                       name="min_{{ field }}"
                                                       min="0"
                                                       step="1"
                                                       value="{{ range_filters[field].min is defined ? range_filters[field].min : '' }}"
                                                       placeholder="No min"
                                                       class="form-input">
                                            </div>
                                            <div>
                                                <label for="max-{{ field }}" class="t-caption block mb-1">Maximum</label>
                                                <input type="number"
                                                       id="max-{{ field }}"
                                                       name="max_{{ field }}"
                                                       min="0"
                                                       step="1"
                                                       value="{{ range_filters[field].max is defined ? range_filters[field].max : '' }}"
                                                       placeholder="No max"
                                                       class="form-input">
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            <div class="flex justify-end gap-3 border-t border-slate-100 mt-4 pt-4">
                                {% set clearFilterHref = '/recruitment?division_tab=' ~ (active_division|url_encode) ~ '&page=1&sort=' ~ (sort.col|url_encode) ~ '&order=' ~ (sort.order|url_encode) %}
                                <a href="{{ clearFilterHref }}" class="btn btn-md btn-secondary">Clear filters</a>
                                <button type="submit" class="btn btn-md btn-primary">Apply filters</button>
                            </div>
                        </form>
                    </details>

                    {% if favourite_tracks_available %}
                        <p class="t-caption mb-3">
                            <span class="font-semibold">Fav</span> = favourite tracks on the calendar.
                            <span class="font-semibold">C·n</span> this season,
                            <span class="font-semibold">N·n</span> next season. Hover for track names.
                        </p>
                    {% endif %}

                    {# Helper Macro for Headers #}
                    {% macro sortLink(label, col, currentSort, activeDivision, rangeFilterQuery) %}
                        {% set newOrder = (currentSort.col == col and currentSort.order == 'desc') ? 'asc' : 'desc' %}
                        {% set icon = '' %}
                        {% if currentSort.col == col %}
                            {% set icon = (currentSort.order == 'desc') ? ' ↓' : ' ↑' %}
                        {% endif %}
                        {% set href = '/recruitment?division_tab=' ~ (activeDivision|url_encode) ~ '&page=1&sort=' ~ (col|url_encode) ~ '&order=' ~ (newOrder|url_encode) %}
                        {% if rangeFilterQuery %}
                            {% set href = href ~ '&' ~ rangeFilterQuery %}
                        {% endif %}
                        <a href="{{ href }}" class="hover:text-slate-900{{ currentSort.col == col ? ' text-slate-900' : '' }}">{{ label }}{{ icon }}</a>
                    {% endmacro %}

                    {# First columns are the answer (rating, name, OA); the attribute and money
                       columns scroll on a phone. #}
                    <div class="border-t border-slate-200">
                        <div class="dt-scroll">
                            <table class="dt">
                                <thead class="border-b border-slate-200">
                                    <tr>
                                        <th scope="col" class="dt-th text-right">{{ _self.sortLink('Rtg', 'rating', sort, active_division, range_filter_query) }}</th>
                                        <th scope="col" class="dt-th">{{ _self.sortLink('Name', 'NAME', sort, active_division, range_filter_query) }}</th>
                                        <th scope="col" class="dt-th text-right">{{ _self.sortLink('OA', 'OA', sort, active_division, range_filter_query) }}</th>
                                        {% for stat in ['CON', 'TAL', 'AGG', 'EXP', 'TEI', 'STA', 'CHA', 'MOT', 'WEI', 'AGE'] %}
                                            <th scope="col" class="dt-th text-right">{{ _self.sortLink(stat, stat, sort, active_division, range_filter_query) }}</th>
                                        {% endfor %}
                                        {% if favourite_tracks_available %}
                                            <th scope="col" class="dt-th" title="Favourite tracks racing this season (C) and next season (N)">Fav</th>
                                        {% endif %}
                                        <th scope="col" class="dt-th text-right">{{ _self.sortLink('Salary', 'SAL', sort, active_division, range_filter_query) }}</th>
                                        <th scope="col" class="dt-th text-right">{{ _self.sortLink('Fee', 'FEE', sort, active_division, range_filter_query) }}</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    {% for d in recruitment_results %}
                                        <tr>
                                            <td class="dt-td text-right font-semibold text-slate-900">{{ d.rating }}</td>
                                            <td class="dt-td">
                                                {% if d.ID > 0 %}
                                                    <a href="https://gpro.net/gb/DriverProfile.asp?ID={{ d.ID }}" target="_blank" rel="noopener noreferrer"
                                                       class="font-medium text-blue-600 hover:underline" title="Open the GPRO profile">{{ d.NAME }}</a>
                                                {% else %}
                                                    <span class="font-medium text-slate-900">{{ d.NAME }}</span>
                                                {% endif %}
                                                {% if d.OFF > 0 %}
                                                    <span class="ml-1.5 inline-flex items-center rounded-md bg-amber-100 px-1.5 py-px text-[10px] font-medium text-amber-800">{{ d.OFF }} offer{{ d.OFF == 1 ? '' : 's' }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="dt-td text-right font-semibold text-slate-900">{{ d.OA }}</td>
                                            {% for stat in ['CON', 'TAL', 'AGG', 'EXP', 'TEI', 'STA', 'CHA', 'MOT', 'WEI', 'AGE'] %}
                                                <td class="dt-td text-right text-slate-600">{{ attribute(d, stat) }}</td>
                                            {% endfor %}
                                            {% if favourite_tracks_available %}
                                                {% set curOn = d.FAV_current > 0 %}
                                                {% set nxtOn = d.FAV_next > 0 %}
                                                <td class="dt-td">
                                                    <span class="inline-flex items-center gap-1">
                                                        <span class="rounded-md px-1.5 py-px text-[11px] font-semibold {{ curOn ? 'bg-slate-100 text-slate-900' : 'text-slate-400' }}"
                                                              title="{{ curOn ? 'This season: ' ~ d.FAV_current_names|join(', ') : 'No favourite tracks this season' }}">C·{{ d.FAV_current }}</span>
                                                        <span class="rounded-md px-1.5 py-px text-[11px] font-semibold {{ nxtOn ? 'bg-slate-100 text-slate-900' : 'text-slate-400' }}"
                                                              title="{{ nxtOn ? 'Next season: ' ~ d.FAV_next_names|join(', ') : 'No favourite tracks next season' }}">N·{{ d.FAV_next }}</span>
                                                    </span>
                                                </td>
                                            {% endif %}
                                            <td class="dt-td text-right text-slate-600">${{ d.SAL|number_format }}</td>
                                            <td class="dt-td text-right text-slate-600">${{ d.FEE|number_format }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="{{ favourite_tracks_available ? 16 : 15 }}" class="dt-td py-8 text-center text-slate-500">No candidates found.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {# Pagination Controls #}
                        {% if pagination.total_pages > 1 %}
                            <div class="bg-surface px-4 py-3 flex items-center justify-between border-t border-slate-200 sm:px-6">
                                {% set navigationParams = 'division_tab=' ~ (active_division|url_encode) ~ '&sort=' ~ (sort.col|url_encode) ~ '&order=' ~ (sort.order|url_encode) %}
                                {% if range_filter_query %}
                                    {% set navigationParams = navigationParams ~ '&' ~ range_filter_query %}
                                {% endif %}
                                
                                {# Mobile: prev/next only. #}
                                <div class="flex flex-1 items-center justify-between sm:hidden">
                                    {% if pagination.current > 1 %}
                                        <a href="/recruitment?{{ navigationParams }}&page={{ pagination.current - 1 }}" class="btn btn-md btn-secondary">Previous</a>
                                    {% else %}
                                        <span></span>
                                    {% endif %}
                                    <span class="text-sm text-slate-700 tabular-nums">Page {{ pagination.current }} / {{ pagination.total_pages }}</span>
                                    {% if pagination.current < pagination.total_pages %}
                                        <a href="/recruitment?{{ navigationParams }}&page={{ pagination.current + 1 }}" class="btn btn-md btn-secondary">Next</a>
                                    {% else %}
                                        <span></span>
                                    {% endif %}
                                </div>

                                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                                    <div>
                                        <p class="text-sm text-slate-700 tabular-nums">
                                            Showing <span class="font-medium">{{ (pagination.current - 1) * pagination.per_page + 1 }}</span> to <span class="font-medium">{{ min(pagination.current * pagination.per_page, pagination.total_items) }}</span> of <span class="font-medium">{{ pagination.total_items }}</span> results
                                        </p>
                                    </div>
                                    <div>
                                        <nav class="relative z-0 inline-flex rounded-md -space-x-px" aria-label="Pagination">
                                            {% if pagination.current > 1 %}
                                                <a href="/recruitment?{{ navigationParams }}&page={{ pagination.current - 1 }}" aria-label="Previous page" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-surface text-sm font-medium text-slate-500 hover:bg-slate-50">
                                                     «
                                                </a>
                                            {% endif %}

                                            {# Windowed page list: 1 … current±2 … last. Keeps the bar
                                               usable when the market yields hundreds of pages. #}
                                            {% set window = 2 %}
                                            {% set win_start = max(2, pagination.current - window) %}
                                            {% set win_end = min(pagination.total_pages - 1, pagination.current + window) %}
                                            {% set pages = [1] %}
                                            {% if win_start <= win_end %}
                                                {% set pages = pages|merge(win_start..win_end) %}
                                            {% endif %}
                                            {% if pagination.total_pages > 1 %}
                                                {% set pages = pages|merge([pagination.total_pages]) %}
                                            {% endif %}
                                            {% for i in pages %}
                                                {% if not loop.first and i > pages[loop.index0 - 1] + 1 %}
                                                    <span class="relative inline-flex items-center px-3 py-2 border border-slate-300 bg-surface text-sm text-slate-400 select-none">…</span>
                                                {% endif %}
                                                <a href="/recruitment?{{ navigationParams }}&page={{ i }}"
                                                    {% if i == pagination.current %}aria-current="page"{% endif %}
                                                    class="relative inline-flex items-center px-4 py-2 border text-sm font-medium {{ i == pagination.current ? 'z-10 bg-blue-50 border-blue-500 text-blue-600' : 'bg-surface border-slate-300 text-slate-500 hover:bg-slate-50' }}">
                                                    {{ i }}
                                                </a>
                                            {% endfor %}

                                            {% if pagination.current < pagination.total_pages %}
                                                <a href="/recruitment?{{ navigationParams }}&page={{ pagination.current + 1 }}" aria-label="Next page" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-surface text-sm font-medium text-slate-500 hover:bg-slate-50">
                                                    »
                                                </a>
                                            {% endif %}
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
