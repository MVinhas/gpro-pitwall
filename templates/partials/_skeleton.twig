{# Loading placeholder for a screen whose GPRO data is still on its way
   (App\Support\DeferredRender). Each screen gets its own outline so the real
   content lands where the eye already is; bar widths vary so rows read as
   text, not as a grid. Decorative only — the live region in index.twig is
   what assistive tech hears. #}

{% set widths = ['w-2/5', 'w-1/3', 'w-1/2', 'w-1/4', 'w-3/5', 'w-1/3'] %}

{# Grouped accordion rows, as the cockpit draws them. #}
{% macro rows(n, widths) %}
    <div>
        <span class="skel mb-2.5 h-3 w-16"></span>
        <div class="card divide-y divide-slate-200">
            {% for i in 1..n %}
                <div class="flex items-center gap-4 px-4 py-3.5 sm:px-6 sm:py-4">
                    <div class="flex-1 space-y-2">
                        <span class="skel h-3.5 {{ widths[i % 6] }}"></span>
                        <span class="skel h-2.5 w-1/4"></span>
                    </div>
                    <span class="skel hidden h-3.5 w-20 sm:block"></span>
                    <span class="skel size-4 rounded-full"></span>
                </div>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{# A card with a header band and a table body. #}
{% macro table(n, cols, widths) %}
    <div class="card">
        <div class="card-hd flex items-center justify-between gap-4">
            <span class="skel h-4 w-40"></span>
            <span class="skel h-3 w-20"></span>
        </div>
        <div class="divide-y divide-slate-100">
            {% for i in 1..n %}
                <div class="flex items-center gap-4 px-4 py-3 sm:px-6">
                    <span class="skel h-3 {{ widths[i % 6] }} max-w-48"></span>
                    {% for c in 1..cols %}
                        <span class="skel ml-auto h-3 w-10 {{ c > 2 ? 'hidden sm:block' : '' }}"></span>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{# A form card: label + control pairs. #}
{% macro form(n, grid) %}
    <div class="card">
        <div class="card-hd"><span class="skel h-4 w-32"></span></div>
        <div class="card-bd grid gap-4 {{ grid }}">
            {% for i in 1..n %}
                <div class="space-y-2">
                    <span class="skel h-2.5 w-16"></span>
                    <span class="skel h-9 w-full"></span>
                </div>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

<div class="space-y-6" aria-hidden="true">
    {% if tab == 'Cockpit' %}
        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
            <div class="lg:col-span-7">{{ _self.rows(3, widths) }}</div>
            <div class="lg:col-span-5">{{ _self.rows(5, widths) }}</div>
        </div>

    {% elseif tab == 'Race Strategy' %}
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
            <div class="lg:col-span-3">{{ _self.form(5, 'grid-cols-2 lg:grid-cols-1') }}</div>
            <div class="order-first space-y-6 lg:order-none lg:col-span-9">
                <div class="card card-bd flex flex-wrap items-center gap-x-8 gap-y-3">
                    {% for i in 1..4 %}
                        <div class="space-y-2">
                            <span class="skel h-2.5 w-14"></span>
                            <span class="skel h-5 w-24"></span>
                        </div>
                    {% endfor %}
                </div>
                {{ _self.table(6, 5, widths) }}
            </div>
        </div>

    {% elseif tab == 'Car Wear Planner' %}
        <div class="card card-bd space-y-3">
            <span class="skel h-4 w-48"></span>
            <span class="skel h-2 w-full"></span>
        </div>
        {{ _self.table(8, 5, widths) }}

    {% elseif tab == 'Testing' %}
        <div class="card">
            <div class="card-hd"><span class="skel h-4 w-36"></span></div>
            <div class="grid grid-cols-1 divide-y divide-slate-200 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
                {% for i in 1..2 %}
                    <div class="space-y-2.5 p-5">
                        <span class="skel h-2.5 w-20"></span>
                        <span class="skel h-6 w-28"></span>
                        <span class="skel h-2.5 w-2/3"></span>
                    </div>
                {% endfor %}
            </div>
        </div>
        {{ _self.table(6, 4, widths) }}

    {% elseif tab == 'Training Planner' %}
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
            <div class="lg:col-span-5">{{ _self.form(9, 'grid-cols-3') }}</div>
            <div class="lg:col-span-7">{{ _self.table(5, 3, widths) }}</div>
        </div>

    {% else %}
        {{ _self.table(5, 3, widths) }}
    {% endif %}
</div>
