
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    {# LEFT: Configuration Panel #}
    <div class="lg:col-span-3 lg:sticky lg:top-16 self-start">
        <form method="POST" action="/calculate_strategy" id="stratForm">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            {# Race settings. Every control recalculates the sheet as it changes,
               so on a phone (answer first) the card closes to one summary row. #}
            {% set bs = strategy_results.inputs.boost_stints ?? 0 %}
            {% embed 'partials/_acc.twig' with { id: 'strategy-settings', title: 'Race settings', lg_open: true, stacked: true, extra_class: 'mb-4' } %}
                {% block verdict %}
                    <span class="block text-xs text-slate-600 tabular-nums group-open/acc:hidden" data-settings-summary>CTR {{ strategy_results.inputs.risk ?? 0 }} · pit at {{ strategy_results.inputs.target_wear ?? 15 }}% tyres · {{ bs == 0 ? 'no boost' : bs ~ ' boost stint' ~ (bs == 1 ? '' : 's') }}</span>
                {% endblock %}
                {% block body %}
                <div class="space-y-3">
                    <div class="flex items-center justify-between gap-3">
                        <label class="t-label" for="stratTemp">Track temp</label>
                        <div class="form-input-group w-24">
                            <input type="number" id="stratTemp" name="temp" value="{{ strategy_results.inputs.temp ?? '' }}" placeholder="Auto" step="0.1" data-strategy-fragment-trigger class="form-input-compact">
                            <span class="form-input-addon">°C</span>
                        </div>
                    </div>
                    <div>
                        <label class="t-label block mb-1" for="stratRisk">Clear track risk</label>
                        <div class="flex items-center gap-3">
                            <input type="range" id="stratRisk" name="risk" min="0" max="100"
                                   value="{{ strategy_results.inputs.risk ?? 0 }}"
                                   data-strategy-fragment-trigger data-slider-live
                                   class="range">
                            <span data-slider-value
                                  class="text-sm font-semibold text-slate-900 w-10 text-right tabular-nums">{{ strategy_results.inputs.risk ?? 0 }}</span>
                        </div>
                    </div>
                    <div>
                        <label class="t-label block mb-1" for="stratTyreWear" title="Tyre condition left when each stint ends">Pit at tyre condition (%)</label>
                        <div class="flex items-center gap-3">
                            <input type="range" id="stratTyreWear" name="target_wear" min="0" max="100"
                                   value="{{ strategy_results.inputs.target_wear ?? 15 }}"
                                   data-strategy-fragment-trigger data-slider-live
                                   class="range">
                            <span data-slider-value
                                  class="text-sm font-semibold text-slate-900 w-10 text-right tabular-nums">{{ strategy_results.inputs.target_wear ?? 15 }}</span>
                        </div>
                    </div>
                    <div>
                        <label class="t-label block mb-1" for="stratBoost" title="Each stint runs 3 boost laps. Extra fuel is spread across race stints.">Boost lap stints</label>
                        <select id="stratBoost" name="boost_stints" data-strategy-fragment-trigger class="form-select">
                            <option value="0" {{ bs == 0 ? 'selected' }}>0 — no boost (0 laps)</option>
                            <option value="1" {{ bs == 1 ? 'selected' }}>1 stint (3 boost laps)</option>
                            <option value="2" {{ bs == 2 ? 'selected' }}>2 stints (6 boost laps)</option>
                            <option value="3" {{ bs == 3 ? 'selected' }}>3 stints (9 boost laps)</option>
                        </select>
                    </div>
                </div>
                {% endblock %}
            {% endembed %}

            {# Session weather the calculation ran with. The Race sheet re-emits these
               (and the race-weather select) with form="stratForm"; these copies keep
               the POST whole when the results panel is showing an error instead. #}
            <input type="hidden" name="q1_temp" value="{{ strategy_results.weather_inputs.Q1.temp }}">
            <input type="hidden" name="q1_weather" value="{{ strategy_results.weather_inputs.Q1.weather }}">
            <input type="hidden" name="q2_temp" value="{{ strategy_results.weather_inputs.Q2.temp }}">
            <input type="hidden" name="q2_weather" value="{{ strategy_results.weather_inputs.Q2.weather }}">
            <input type="hidden" name="race_weather" value="{{ strategy_results.weather_inputs.Race.weather }}">

            <noscript>
                <button type="submit" class="btn btn-lg btn-primary w-full">Calculate strategy</button>
            </noscript>
        </form>

        {# Read-only reference: driver/car/staff snapshot from the last sync #}
        <div class="mt-4">
            {% embed 'partials/_acc.twig' with {
                id: 'strategy-data',
                title: 'Data used — from last sync',
                caption: 'Driver, car and staff snapshot',
                stacked: true,
                stats: strategy_results.stats,
                last_synced_at: user.last_synced_at
            } only %}
                {% block verdict %}
                    {% import 'partials/_localtime.twig' as t %}
                    {% if last_synced_at %}
                        <span class="text-xs text-slate-500 tabular-nums">{{ t.localtime(last_synced_at, 'datetime') }}</span>
                    {% endif %}
                {% endblock %}
                {% block body %}
                    <div class="space-y-3">
                        <div class="space-y-1 text-xs">
                            <p class="t-label">Driver</p>
                            <div class="space-y-1">
                                {% for key, label in {
                                    'concentration':     'Concentration',
                                    'talent':            'Talent',
                                    'aggressiveness':    'Aggressiveness',
                                    'experience':        'Experience',
                                    'technical_insight': 'Tech Insight',
                                    'weight':            'Weight'
                                } %}
                                    <span class="flex justify-between gap-4">
                                        <span class="text-slate-400">{{ label }}</span>
                                        <span class="font-semibold text-slate-700 tabular-nums">{{ stats.driver[key] }}{% if key == 'weight' %}<span class="font-normal text-slate-400"> kg</span>{% endif %}</span>
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="space-y-1 text-xs">
                            <p class="t-label">Car levels</p>
                            <div class="space-y-1">
                                {% for key, label in { 'lvlEngine': 'Engine', 'lvlSusp': 'Suspension', 'lvlElectronics': 'Electronics' } %}
                                    <span class="flex justify-between gap-4">
                                        <span class="text-slate-400">{{ label }}</span>
                                        <span class="font-semibold text-slate-700 tabular-nums">{{ stats.car[key] }}</span>
                                    </span>
                                {% endfor %}
                            </div>
                            <p class="t-label pt-2">Staff</p>
                            <div class="space-y-1">
                                <span class="flex justify-between gap-4">
                                    <span class="text-slate-400">Concentration</span>
                                    <span class="font-semibold text-slate-700 tabular-nums">{{ stats.staff.concentration }}</span>
                                </span>
                                <span class="flex justify-between gap-4">
                                    <span class="text-slate-400">Stress Handling</span>
                                    <span class="font-semibold text-slate-700 tabular-nums">{{ stats.staff.stressHandling }}</span>
                                </span>
                            </div>
                            <p class="t-label pt-2">Tech Director</p>
                            <div class="space-y-1">
                                <span class="flex justify-between gap-4">
                                    <span class="text-slate-400">Experience</span>
                                    <span class="font-semibold text-slate-700 tabular-nums">{{ stats.td.experience }}</span>
                                </span>
                                <span class="flex justify-between gap-4">
                                    <span class="text-slate-400">Pit Coordination</span>
                                    <span class="font-semibold text-slate-700 tabular-nums">{{ stats.td.pitCoordination }}</span>
                                </span>
                            </div>
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# RIGHT: Results Display #}
    <div class="order-first lg:order-none lg:col-span-9" id="strategy-results-card" data-failure-message="{{ generic_error_message }}">
        {% include 'partials/_strategy_results.twig' %}
    </div>
</div>

{# Loading + risk-slider fragment refresh #}
<script>
(() => {
    const form = document.getElementById('stratForm');
    const card = document.getElementById('strategy-results-card');
    if (!form || !card) return;

    let pending = null;

    const summary = form.querySelector('[data-settings-summary]');
    const describe = () => {
        if (!summary) return;
        const stints = parseInt(form.elements.boost_stints.value, 10) || 0;
        const boost = stints === 0 ? 'no boost' : stints + ' boost stint' + (stints === 1 ? '' : 's');
        summary.textContent = 'CTR ' + form.elements.risk.value + ' · pit at ' + form.elements.target_wear.value + '% tyres · ' + boost;
    };

    // Live slider value labels (dragging updates the number without server roundtrip).
    document.addEventListener('input', (e) => {
        if (!e.target.matches('[data-slider-live]')) return;
        const label = e.target.parentElement.querySelector('[data-slider-value]');
        if (label) label.textContent = e.target.value;
        describe();
    });

    // Without a submit button Enter would do nothing; treat it as "done editing".
    form.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || !e.target.matches('input[data-strategy-fragment-trigger]')) return;
        e.preventDefault();
        e.target.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // While a recalculation is in flight the panel still shows the previous
    // inputs' result, so it is marked busy; if the request fails, that stale
    // result is replaced by the failure state rather than left under the new
    // inputs as if it answered them.
    const setBusy = (on) => {
        card.setAttribute('aria-busy', on ? 'true' : 'false');
        card.classList.toggle('opacity-60', on);
    };
    const showFailure = () => {
        const box = document.createElement('div');
        box.className = 'notice notice-error';
        box.dataset.resultState = 'failed';
        const title = document.createElement('p');
        title.className = 'font-bold';
        title.textContent = 'Strategy calculation failed.';
        const body = document.createElement('p');
        body.className = 'mt-1';
        body.textContent = card.dataset.failureMessage || '';
        box.append(title, body);
        card.replaceChildren(box);
    };

    // Sliders + selects flagged as fragment triggers re-run the calc and swap the panel.
    document.addEventListener('change', async (e) => {
        if (!e.target.matches('[data-strategy-fragment-trigger]')) return;
        describe();
        if (pending) pending.abort();
        const request = new AbortController();
        pending = request;
        setBusy(true);
        const data = new FormData(form);
        try {
            const res = await fetch('/strategy_fragment', {
                method: 'POST',
                body: data,
                signal: request.signal,
                headers: { 'X-Requested-With': 'fetch' },
            });
            if (res.redirected || res.status === 401 || res.status === 403) {
                // Session expired mid-page — reload; the remember-me restore signs back in.
                window.location.reload();
                return;
            }
            if (!res.ok) {
                showFailure();
                return;
            }
            const html = await res.text();
            // A whole document here means something other than the fragment
            // endpoint answered — never nest it inside the card.
            if (/<!doctype/i.test(html)) {
                window.location.reload();
                return;
            }
            card.innerHTML = html;
            window.applyAccState(card);
        } catch (err) {
            if (err.name === 'AbortError') return;
            console.error(err);
            showFailure();
        } finally {
            // A newer request owns the busy state once this one was superseded.
            if (pending === request) setBusy(false);
        }
    });
})();
</script>
