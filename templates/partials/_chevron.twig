{# The card-summary disclosure chevron, pinned to the summary grid's last column.
   `group` names the <details> it belongs to, so a nested disclosure never
   rotates its parent's chevron. The rotate classes are literal (not
   interpolated) so the Tailwind scanner emits them. #}
{% set rotate = {acc: 'group-open/acc:rotate-180', wear: 'group-open/wear:rotate-180'}[group] %}
<svg class="col-start-2 row-span-2 row-start-1 size-4 shrink-0 self-center text-slate-400 transition-transform sm:col-start-3 sm:row-span-1 {{ rotate }}"
     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
</svg>
