{% if testing_error == no_pilot_message %}
    {% include 'partials/_no_pilot_notice.twig' %}
{% elseif testing_error == generic_error_message %}
    <div class="notice notice-error"><span class="font-bold">Couldn't load Testing.</span> {{ testing_error }}</div>
{% elseif testing_error %}
    <div class="notice notice-warn"><span class="font-bold">Testing unavailable.</span> {{ testing_error }}</div>
{% elseif testing_results %}
    {% set r = testing_results %}

    {# Two flowing columns (single grid, no shared row heights, so cards stack
       flush): left = track facts + per-priority gains, right = points
       distribution + ideal setup. Stacked in that order on mobile. #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6 items-start">

    <div class="space-y-6">

    {# ===== TRACK + CAR ===== #}
    <div class="card">
        <div class="card-hd flex flex-wrap items-center justify-between gap-2">
            <div>
                <h3 class="t-section">{{ r.track.name }}</h3>
                <p class="t-caption">Testing track · Season {{ r.season }}, Race {{ r.race }}</p>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-600">
                <span class="font-semibold">{{ r.weather.temp }}°C</span>
                <span class="px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-700">{{ r.weather.label }}</span>
                <span class="text-slate-400">·</span>
                <span>{{ r.weather.hum }}% hum</span>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
            <div class="p-5">
                <p class="t-label mb-3">Track demands</p>
                <dl class="grid grid-cols-3 gap-3 text-center">
                    {% for label, key in {'Power': 'power', 'Handling': 'handling', 'Accel': 'acceleration'} %}
                        <div>
                            <dt class="t-caption">{{ label }}</dt>
                            <dd class="text-lg font-semibold tabular-nums text-slate-900">{{ r.track[key]|round(1) }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            </div>
            <div class="p-5">
                <p class="t-label mb-3">Your car</p>
                <dl class="grid grid-cols-3 gap-3 text-center">
                    {% for label, key in {'Power': 'power', 'Handling': 'handling', 'Accel': 'acceleration'} %}
                        <div>
                            <dt class="t-caption">{{ label }}</dt>
                            <dd class="text-lg font-semibold tabular-nums text-slate-900">{{ r.car[key]|round(1) }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            </div>
        </div>
    </div>

    {# ===== POINTS PER 5 LAPS BY PRIORITY ===== #}
    <div class="card">
        <div class="card-hd">
            <h3 class="t-section">Points gained per 5 laps</h3>
        </div>
        <div class="dt-inset">
            <table class="dt">
                <thead class="border-b border-slate-200">
                    <tr>
                        <th scope="col" class="dt-th">Priority</th>
                        <th scope="col" class="dt-th text-right">Power</th>
                        <th scope="col" class="dt-th text-right">Handling</th>
                        <th scope="col" class="dt-th text-right">Accel</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for name, pts in r.priority_gains %}
                        <tr>
                            <td class="dt-td whitespace-normal">{{ name }}</td>
                            <td class="dt-td text-right text-slate-900">{{ pts.power }}</td>
                            <td class="dt-td text-right text-slate-900">{{ pts.handling }}</td>
                            <td class="dt-td text-right text-slate-900">{{ pts.acceleration }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    </div>{# /left column #}

    <div class="space-y-6">

    {# ===== POINTS DISTRIBUTION ===== #}
    <div class="card">
        <div class="card-hd">
            <h3 class="t-section">Points distribution</h3>
        </div>
        <div class="dt-inset">
            <table class="dt">
                <thead class="border-b border-slate-200">
                    <tr>
                        <th scope="col" class="dt-th">Characteristic</th>
                        <th scope="col" class="dt-th text-right hidden sm:table-cell">Test</th>
                        <th scope="col" class="dt-th text-right hidden sm:table-cell">R&amp;D</th>
                        <th scope="col" class="dt-th text-right hidden sm:table-cell">Engineering</th>
                        <th scope="col" class="dt-th text-right text-slate-900">Car character</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for label, key in {'Power': 'power', 'Handling': 'handling', 'Acceleration': 'acceleration'} %}
                        <tr>
                            <td class="dt-td">{{ label }}</td>
                            <td class="dt-td text-right text-slate-500 hidden sm:table-cell">{{ r.points.test[key]|round(1) }}</td>
                            <td class="dt-td text-right text-slate-500 hidden sm:table-cell">{{ r.points.rd[key]|round(1) }}</td>
                            <td class="dt-td text-right text-slate-500 hidden sm:table-cell">{{ r.points.eng[key]|round(1) }}</td>
                            <td class="dt-td text-right font-semibold text-slate-900">{{ r.points.car_character[key]|round(1) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="border-t border-slate-100 px-4 py-3 sm:px-6">
            {% embed 'partials/_how.twig' %}{% block how %}
                <p>Car Character is what actually lands in your car: test points decay through Test → R&amp;D → Engineering before they arrive.</p>
            {% endblock %}{% endembed %}
        </div>
    </div>

    {# ===== IDEAL SETUP ===== #}
    {% if r.setup %}
        <div class="card">
            <div class="card-hd">
                <h3 class="t-section">Ideal setup</h3>
            </div>
            <div class="dt-inset">
                <table class="dt">
                    <tbody class="divide-y divide-slate-100">
                        {% for part in ['Front Wing', 'Rear Wing', 'Engine', 'Brakes', 'Gearbox', 'Suspension'] %}
                            {% set v = r.setup[part] %}
                            <tr>
                                <th scope="row" class="dt-td text-left font-normal text-slate-700">{{ part }}</th>
                                <td class="dt-td text-right font-semibold text-slate-900">
                                    {% if v > 999 %}999<span class="block text-[10px] font-normal text-slate-400" title="Computed {{ v }} — GPRO accepts at most 999">{{ v }}</span>{% else %}{{ v }}{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    </div>{# /right column #}

    </div>{# /two-column grid #}

    {# ===== EXPECTED WEAR (dynamic by laps) ===== #}
    {% if r.wear %}
        <div class="card mb-6" id="testing-wear">
            <div class="card-hd space-y-2">
                <div class="flex items-center justify-between gap-4">
                    <h3 class="t-section">Expected car wear</h3>
                    <span class="text-sm text-slate-600">Testing laps <span data-laps-value class="font-semibold text-slate-900 tabular-nums">{{ r.default_laps }}</span></span>
                </div>
                <input type="range" min="5" max="{{ r.max_laps }}" step="5" value="{{ r.default_laps }}"
                       data-testing-laps aria-label="Testing laps"
                       class="range">
            </div>
            <div class="dt-inset">
                <table class="dt">
                    <thead class="border-b border-slate-200">
                        <tr>
                            <th scope="col" class="dt-th">Part</th>
                            <th scope="col" class="dt-th text-right hidden sm:table-cell">Current</th>
                            <th scope="col" class="dt-th text-right">Added</th>
                            <th scope="col" class="dt-th text-right">After testing</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for part, data in r.wear.parts %}
                            <tr data-wear-row data-start="{{ data.start }}" data-per-lap="{{ data.per_lap }}">
                                <td class="dt-td">{{ part }}</td>
                                <td class="dt-td text-right text-slate-500 hidden sm:table-cell">{{ data.start }}%</td>
                                <td class="dt-td text-right text-slate-500" data-wear-added>—</td>
                                <td class="dt-td text-right">
                                    <span data-wear-end class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium tabular-nums">—</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="border-t border-slate-100 px-4 py-3 sm:px-6">
                <p class="text-xs text-slate-500">Estimate — per-lap wear is this track's race wear, scaled by your driver and the lower testing wear rate (about half a race lap).</p>
            </div>
        </div>

        <script>
        (() => {
            const root = document.getElementById('testing-wear');
            if (!root) return;
            const slider = root.querySelector('[data-testing-laps]');
            const lapsLabel = root.querySelector('[data-laps-value]');
            const rows = root.querySelectorAll('[data-wear-row]');

            // Only a part that needs attention gets a tone; a healthy one stays ink.
            const badge = (end) => {
                if (end >= 90) return 'bg-red-100 text-red-800';
                if (end >= 50) return 'bg-amber-100 text-amber-800';
                return 'text-slate-700';
            };

            const render = (laps) => {
                lapsLabel.textContent = laps;
                rows.forEach((row) => {
                    const start = parseFloat(row.dataset.start) || 0;
                    const perLap = parseFloat(row.dataset.perLap) || 0;
                    const added = Math.round(perLap * laps * 10) / 10;
                    const end = Math.round((start + added) * 10) / 10;
                    row.querySelector('[data-wear-added]').textContent = '+' + added + '%';
                    const endEl = row.querySelector('[data-wear-end]');
                    endEl.textContent = end + '%';
                    endEl.className = 'inline-flex items-center rounded-md px-2 py-1 text-xs font-medium tabular-nums ' + badge(end);
                });
            };

            slider.addEventListener('input', (e) => render(parseInt(e.target.value, 10)));
            render(parseInt(slider.value, 10));
        })();
        </script>
    {% endif %}

{% else %}
    {% include 'partials/_empty.twig' with { title: 'No testing data yet', body: 'Re-sync to load this race\'s testing track.' } only %}
{% endif %}
