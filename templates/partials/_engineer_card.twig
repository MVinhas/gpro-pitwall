{# Admin-only race engineer. Renders nothing without `engineer` (non-admins, or the
   engineer failed): the Engineer tab then shows its empty state. The objective label already
   carries both calls when pinned ("Your call: … (engineer proposes …)"). #}
{% if engineer is defined and engineer is not empty %}
    {% set objective = engineer.objective %}
    {% set step_titles = {car: 'Step 1 · Update the car', prep: 'Step 2 · Testing and training', race: 'Step 3 · Race settings'} %}
    {% set labels = {ctr: 'CTR', parts: 'parts', smoke: 'letting a part smoke', risk: 'risk settings', tyres: 'tyre supplier'} %}
    <section class="card" aria-labelledby="engineer-title">
        <div class="card-hd flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
                <h3 id="engineer-title" class="t-section">Race engineer</h3>
                <p class="t-caption mt-0.5">Season objective: <span class="font-semibold text-slate-900">{{ objective.label }}</span></p>
            </div>
            <form method="post" action="/engineer/objective" class="flex items-center gap-2">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="season" value="{{ engineer.season }}">
                <label for="engineer-objective" class="sr-only">Season objective</label>
                <select id="engineer-objective" name="objective" class="form-select text-sm">
                    <option value="auto"{{ not objective.pinned ? ' selected' : '' }}>Auto</option>
                    <option value="promote"{{ objective.pinned and objective.objective == 'promote' ? ' selected' : '' }}>Promote</option>
                    <option value="stay"{{ objective.pinned and objective.objective == 'stay' ? ' selected' : '' }}>Stay</option>
                </select>
                <button type="submit" class="btn btn-sm btn-secondary">Pin</button>
            </form>
        </div>
        {% if objective.warning %}
            <div class="notice notice-warn notice-slim mx-4 mt-4 sm:mx-6">
                <p><span class="font-bold">Check the objective.</span> {{ objective.warning }}</p>
            </div>
        {% endif %}
        <div class="card-bd divide-y divide-slate-200">
            {% for line in engineer.lines %}
                {% set step = line.step|default('season') %}
                {% set prev_step = loop.first ? null : engineer.lines[loop.index0 - 1].step|default('season') %}
                {% if step != prev_step and step != 'season' %}
                    <div role="group" aria-labelledby="engineer-step-{{ step }}" class="py-3 first:pt-0 last:pb-0">
                        <h4 id="engineer-step-{{ step }}" class="t-label mb-2 flex items-center gap-2 whitespace-nowrap">
                            {{ step_titles[step] }}
                            {% if step == 'car' and engineer.car_updated %}<span class="rounded-md border border-slate-300 px-1.5 py-0.5 text-xs font-medium normal-case tracking-normal text-slate-900">Done</span>{% endif %}
                        </h4>
                        <div class="divide-y divide-slate-200">
                {% endif %}
                <div class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                    <div class="min-w-0">
                        <p class="text-sm font-semibold {{ line.tone == 'red' ? 'text-red-700' : (line.tone == 'amber' ? 'text-amber-700' : 'text-slate-900') }}">
                            {{ line.answer }}{% if line.figure %} <span class="tabular-nums font-normal text-slate-600">· {{ line.figure }}</span>{% endif %}
                        </p>
                        {% if line.reason %}<p class="mt-0.5 text-xs text-slate-600">{{ line.reason }}</p>{% endif %}
                    </div>
                    {% if line.action or line.anchor or line.choice is defined %}
                        <div class="flex shrink-0 flex-wrap items-center gap-3">
                            {% if line.anchor %}<a href="{{ line.anchor }}" class="text-xs font-medium text-blue-600 hover:underline">Details<span class="sr-only"> for {{ labels[line.key] ?? line.key }}</span></a>{% endif %}
                            {% if line.choice is defined %}
                                {% set choice_buttons = line.choice.chosen is null
                                    ? [{value: 'do', label: "I'll do it"}, {value: 'skip', label: 'Decline'}]
                                    : [{value: 'clear', label: 'Undo'}] %}
                                {% for button in choice_buttons %}
                                    <form method="post" action="/engineer/choice">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="season" value="{{ line.choice.season }}">
                                        <input type="hidden" name="race" value="{{ line.choice.race }}">
                                        <input type="hidden" name="item" value="{{ line.choice.item }}">
                                        <input type="hidden" name="choice" value="{{ button.value }}">
                                        <button type="submit" class="btn btn-sm btn-secondary">{{ button.label }}<span class="sr-only"> for {{ line.choice.item }}</span></button>
                                    </form>
                                {% endfor %}
                            {% endif %}
                            {% if line.action %}<a href="{{ line.action.href }}" class="btn btn-sm btn-secondary">{{ line.action.label }}</a>{% endif %}
                        </div>
                    {% endif %}
                </div>
                {% set next_step = loop.last ? null : engineer.lines[loop.index0 + 1].step|default('season') %}
                {% if step != 'season' and next_step != step %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>
{% endif %}
