<div class="space-y-6">
    {% if cockpit_error == no_pilot_message %}
        {% include 'partials/_no_pilot_notice.twig' %}
        {% if engineer_driver is defined and engineer_driver is not null %}
            {% include 'partials/_engineer_driver.twig' with {panel: engineer_driver.panel} %}
        {% endif %}
    {% elseif cockpit_error %}
        <div class="notice notice-error">
            <p class="font-bold">Couldn't load the race engineer.</p>
            <p class="mt-1">{{ cockpit_error }}</p>
        </div>
    {% elseif cockpit_data_loaded is not defined %}
        {% include 'partials/_no_data.twig' %}
    {% elseif engineer is not defined %}
        <div class="notice notice-error">
            <p class="font-bold">Couldn't build the advice.</p>
            <p class="mt-1">The other screens are unaffected.</p>
        </div>
    {% else %}
        {% include 'partials/_engineer_card.twig' %}
        {% if engineer.tyres %}{% include 'partials/_engineer_tyres.twig' %}{% endif %}
        {% if engineer.driver %}{% include 'partials/_engineer_driver.twig' with {panel: engineer.driver} %}{% endif %}
    {% endif %}
</div>
