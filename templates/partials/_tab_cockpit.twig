<div class="space-y-6">


    {% if cockpit_error == no_pilot_message %}
        {% include 'partials/_no_pilot_notice.twig' %}
    {% elseif cockpit_error %}
        <div class="notice notice-error">
            <p class="font-bold">Couldn't load cockpit data.</p>
            <p class="mt-1">{{ cockpit_error }}</p>
        </div>
    {% elseif pha is not defined %}
        {% include 'partials/_empty.twig' with { title: 'No synced data yet', body: 'Add your GPRO API token and re-sync to fill the cockpit.' } only %}
    {% else %}

        {# Verdicts computed once, reused by each card's summary and body. A card
           renders open only when its verdict needs the manager; healthy cards stay
           closed and still inform through the verdict in their summary. #}
        {% set best_test = null %}
        {% if testing_projection is defined and testing_projection is not empty %}
            {% for p in testing_projection %}
                {% if best_test is null or (p.landed.power + p.landed.handling + p.landed.acceleration) > (best_test.landed.power + best_test.landed.handling + best_test.landed.acceleration) %}
                    {% set best_test = p %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {# Training scores are internal and often tie: the verdict names every pick
           sharing the top score, in ink, and never shows the score itself. #}
        {% set training_verdict = '' %}
        {% if training_picks is defined and training_picks is not empty %}
            {% set top_score = training_picks[0].score %}
            {% set top_names = training_picks|filter(p => p.score == top_score)|map(p => p.name) %}
            {% set training_verdict = top_score > 0 ? top_names|join(' or ') : 'No training helps' %}
        {% endif %}

        {% set spon_contested = false %}
        {% set spon_attention = false %}
        {% if sponsor_negotiations is defined %}
            {% for neg in sponsor_negotiations.ongoing %}
                {% if neg.contested == 'Yes' %}{% set spon_contested = true %}{% endif %}
                {% if neg.attention %}{% set spon_attention = true %}{% endif %}
            {% endfor %}
        {% endif %}

        {% set pha_attention = pha.match == 'none' %}
        {% set wear_attention = wear_advice is defined and (wear_advice.swap is not empty or wear_advice.risky is not empty) %}
        {% set weather_attention = weather is defined and (weather.q1_wet or weather.q2_wet or weather.race_start_wet) %}
        {% set sponsor_attention = spon_contested or spon_attention %}

        {% if cockpit_setup_stale %}
            <div class="notice notice-warn">
                <p class="font-bold">Weather forecast not available yet.</p>
                <p>Track and P/H/A are current for {{ pha_track_name }}, but GPRO is still serving the previous race's setup, so its weather is withheld. Re-sync once GPRO opens the new race's setup.</p>
            </div>
        {% endif %}

        {# Two subject groups, one order on every viewport: the car first, then the
           rest of the weekend. Each group is one list of rows — a card per row
           would be chrome around a single line. The car column is wider: it
           carries the parts plan, the largest decision on the page. #}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <section aria-labelledby="cockpit-car" class="lg:col-span-7">
                <h3 id="cockpit-car" class="t-label mb-2">Car</h3>
                <div class="card divide-y divide-slate-200">

                    {% embed 'partials/_acc.twig' with {
                        id: 'pha',
                        variant: 'row',
                        title: 'P/H/A match',
                        caption: pha_track_name,
                        open_default: pha_attention,
                        pha: pha,
                    } only %}
                        {% block verdict %}
                            <span class="text-xs font-semibold">{% if pha.favourite %}<span title="Driver's favourite track">★</span> {% endif %}{% if pha.match == 'perfect' %}<span class="text-emerald-700">Perfect match</span>{% elseif pha.match == 'top' %}<span class="text-slate-700">Top match</span>{% else %}<span class="text-slate-700">No match</span>{% endif %}</span>
                        {% endblock %}
                        {% block body %}
                            <div class="space-y-3">
                                <table class="dt">
                                    <caption class="sr-only">Track demand and car rank per attribute</caption>
                                    <thead class="border-b border-slate-200">
                                        <tr>
                                            <th scope="col" class="dt-th">Attribute</th>
                                            <th scope="col" class="dt-th text-right">Track</th>
                                            <th scope="col" class="dt-th text-right">Car</th>
                                            <th scope="col" class="dt-th text-right">Match</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        {% for attr, d in pha.attributes %}
                                            <tr>
                                                <td class="dt-td capitalize">{{ attr }}</td>
                                                <td class="dt-td text-right"><span class="font-semibold text-slate-900">{{ d.track }}</span> <span class="text-xs text-slate-500">#{{ d.track_rank }}</span></td>
                                                <td class="dt-td text-right"><span class="font-semibold text-slate-900">{{ d.car }}</span> <span class="text-xs text-slate-500">#{{ d.car_rank }}</span></td>
                                                <td class="dt-td text-right">{% if d.aligned %}<span class="font-bold text-emerald-700">✓</span><span class="sr-only">aligned</span>{% else %}<span class="text-slate-300">—</span><span class="sr-only">not aligned</span>{% endif %}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>

                                {% embed 'partials/_how.twig' %}{% block how %}
                                    <p>Rank #1 is the attribute the track demands most, or your car's strongest. Top match: the two #1s line up. Perfect match: all three ranks line up.</p>
                                {% endblock %}{% endembed %}
                            </div>
                        {% endblock %}
                    {% endembed %}

                    {# Hand-rolled details: the fragment endpoint re-renders
                       _cockpit_wear.twig into this element's innerHTML, so an embed
                       would duplicate the wrapper. Named group (group/wear) keeps the
                       chevron independent of the nested swap/PHA accordions inside. #}
                    {% if wear_advice is defined %}
                        <details id="wear" data-acc {{ wear_attention ? 'open' : '' }} class="group/wear scroll-mt-16">
                            {% include 'partials/_cockpit_wear.twig' %}
                        </details>
                    {% endif %}

                    {% if testing_projection is defined and testing_projection is not empty %}
                        {% embed 'partials/_acc.twig' with {
                            id: 'testing',
                            variant: 'row',
                            title: 'If you test 100 laps today',
                            testing_projection: testing_projection,
                            testing_targets: testing_targets|default(null),
                            best_test: best_test,
                        } only %}
                            {% block verdict %}
                                <span class="text-xs text-slate-600">Recommended: <span class="font-semibold text-slate-900">{{ best_test.priority }}</span></span>
                            {% endblock %}
                            {% block body %}
                                <div class="space-y-4">
                                    {# One value per cell: what lands in the car, and the car it leaves.
                                       Raw test points are the landed value before decay; the "how" says so. #}
                                    <div class="dt-scroll">
                                        <table class="dt">
                                            <thead>
                                                <tr>
                                                    <th scope="col" rowspan="2" class="dt-th align-bottom">Priority</th>
                                                    <th scope="colgroup" colspan="3" class="dt-th pb-0 text-center">Lands in car</th>
                                                    <th scope="colgroup" colspan="3" class="dt-th pb-0 text-center">Car after race +3</th>
                                                </tr>
                                                <tr class="border-b border-slate-200">
                                                    <th scope="col" class="dt-th pt-1 text-right">P</th>
                                                    <th scope="col" class="dt-th pt-1 text-right">H</th>
                                                    <th scope="col" class="dt-th pt-1 text-right">A</th>
                                                    <th scope="col" class="dt-th pt-1 text-right">P</th>
                                                    <th scope="col" class="dt-th pt-1 text-right">H</th>
                                                    <th scope="col" class="dt-th pt-1 text-right">A</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100">
                                                {% for p in testing_projection %}
                                                    <tr class="{{ p is same as(best_test) ? 'bg-emerald-50' : '' }}">
                                                        <td class="dt-td whitespace-normal">{{ p.priority }}</td>
                                                        <td class="dt-td text-right text-slate-900">+{{ p.landed.power|number_format(1) }}</td>
                                                        <td class="dt-td text-right text-slate-900">+{{ p.landed.handling|number_format(1) }}</td>
                                                        <td class="dt-td text-right text-slate-900">+{{ p.landed.acceleration|number_format(1) }}</td>
                                                        <td class="dt-td text-right text-slate-600">{{ p.new_car.power|number_format(0) }}</td>
                                                        <td class="dt-td text-right text-slate-600">{{ p.new_car.handling|number_format(0) }}</td>
                                                        <td class="dt-td text-right text-slate-600">{{ p.new_car.acceleration|number_format(0) }}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                    {% if testing_targets is not empty %}
                                        <details data-acc id="testing-tracks" class="group/lt rounded-lg border border-slate-200">
                                            <summary class="flex cursor-pointer select-none list-none items-center justify-between px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                                Landing tracks — race +3/+4/+5
                                                <svg class="h-4 w-4 shrink-0 transition-transform group-open/lt:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                                </svg>
                                            </summary>
                                            <div class="border-t border-slate-200 px-4 pb-4 pt-3 space-y-3">
                                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                                    {% for t in testing_targets %}
                                                        <div class="rounded-md border p-3 border-slate-200">
                                                            <p class="t-caption">+{{ t.offset }} → {{ t.season == 'next' ? 'next' : 'this' }} season race {{ t.race }}</p>
                                                            {% if t.track_name %}
                                                                <p class="text-sm font-semibold text-slate-900 mt-0.5">{% if t.favourite %}<span title="Driver's favourite track">★</span> {% endif %}{{ t.track_name }}</p>
                                                                <p class="t-caption tabular-nums">P {{ t.power }} · H {{ t.handling }} · A {{ t.acceleration }}</p>
                                                                {% if t.favourite %}<p class="t-caption mt-0.5">Driver's favourite</p>{% endif %}
                                                            {% else %}
                                                                <p class="t-caption mt-0.5 italic">Next-season calendar not published yet.</p>
                                                            {% endif %}
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </details>
                                    {% endif %}
                                    {% embed 'partials/_how.twig' %}{% block how %}
                                        <p>100 test laps earn raw points per priority; they decay through Test → R&amp;D → Engineering → Car Character at 0.5 per race, so about 12.5% lands in the car by race +3. The highlighted row lands the most in total. Test laps also wear parts.</p>
                                    {% endblock %}{% endembed %}
                                </div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}

                </div>
            </section>

            <section aria-labelledby="cockpit-weekend" class="lg:col-span-5">
                <h3 id="cockpit-weekend" class="t-label mb-2">Weekend</h3>
                <div class="card divide-y divide-slate-200">

                    {% if weather is defined %}
                        {% embed 'partials/_acc.twig' with {
                            id: 'weather',
                            variant: 'row',
                            title: 'Weather',
                            open_default: weather_attention,
                            weather: weather,
                            weather_temps: weather_temps,
                        } only %}
                            {% block verdict %}
                                <span class="text-xs font-semibold text-slate-700">Q1 {{ weather.q1_wet ? 'Wet' : 'Dry' }} · Q2 {{ weather.q2_wet ? 'Wet' : 'Dry' }} · Race {{ weather.race_start_wet ? 'wet' : 'dry' }} ({{ weather.race_rain_avg|round }}% rain)</span>
                            {% endblock %}
                            {% block body %}
                                <div class="space-y-4">
                                    <div class="grid grid-cols-3 gap-3">
                                        <div class="rounded-lg border border-slate-200 p-3 text-center">
                                            <p class="t-label">Q1</p>
                                            <p class="t-value mt-1">{{ weather.q1_wet ? 'Wet' : 'Dry' }}</p>
                                            {% if weather_temps.q1 is not null %}<p class="t-caption">{{ weather_temps.q1 }}°C</p>{% endif %}
                                        </div>
                                        <div class="rounded-lg border border-slate-200 p-3 text-center">
                                            <p class="t-label">Q2</p>
                                            <p class="t-value mt-1">{{ weather.q2_wet ? 'Wet' : 'Dry' }}</p>
                                            {% if weather_temps.q2 is not null %}<p class="t-caption">{{ weather_temps.q2 }}°C</p>{% endif %}
                                        </div>
                                        <div class="rounded-lg border border-slate-200 p-3 text-center">
                                            <p class="t-label">Race start</p>
                                            <p class="t-value mt-1">{{ weather.race_start_wet ? 'Wet' : 'Dry' }}</p>
                                            <p class="t-caption">{{ weather.race_rain_avg|round }}% rain</p>
                                        </div>
                                    </div>
                                    {% embed 'partials/_how.twig' %}{% block how %}
                                        <p>Race start is called wet when the average rain probability across the four race quarters is 50% or more. Forecasts drift; recheck closer to qualifying.</p>
                                    {% endblock %}{% endembed %}
                                </div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}

                    {% if sponsor_negotiations is defined %}
                        {% embed 'partials/_acc.twig' with {
                            id: 'sponsors',
                            variant: 'row',
                            title: 'Sponsors',
                            caption: sponsor_negotiations.car_spots_taken ~ ' / ' ~ sponsor_negotiations.car_spots_total ~ ' car spots filled',
                            open_default: sponsor_attention,
                            sponsor_negotiations: sponsor_negotiations,
                            spon_contested: spon_contested,
                            spon_attention: spon_attention,
                        } only %}
                            {% block verdict %}
                                <span class="text-xs font-semibold text-slate-700">{{ sponsor_negotiations.ongoing|length }} ongoing{% if spon_contested %} · <span class="text-amber-700">contested</span>{% endif %}{% if spon_attention %} · <span class="text-amber-700">needs attention</span>{% endif %}</span>
                            {% endblock %}
                            {% block body %}
                                <div class="space-y-4">
                                    {% if sponsor_negotiations.ongoing is empty %}
                                        <p class="t-caption">No ongoing negotiations.</p>
                                    {% else %}
                                        {% for neg in sponsor_negotiations.ongoing %}
                                            <div class="rounded-md border border-slate-200 p-3">
                                                <div class="flex items-baseline justify-between mb-2 gap-3 flex-wrap">
                                                    <span class="text-sm font-semibold text-slate-900">{{ neg.name }}</span>
                                                    <span class="t-caption">progress {{ neg.progress }}% · priority {{ neg.priority }}{% if neg.contested == 'Yes' %} · <span class="text-amber-700 font-medium">contested</span>{% endif %}{% if neg.attention %} · <span class="text-amber-700 font-medium">needs attention</span>{% endif %}</span>
                                                </div>
                                                {# Every characteristic is on GPRO's 1–7 scale: say it once, not on each chip. #}
                                                <div class="mb-3 flex flex-wrap items-center gap-1">
                                                    <span class="mr-1 text-[10px] font-medium uppercase tracking-wide text-slate-500">Scale 1–7</span>
                                                    {% for k, v in neg.characteristics %}
                                                        <span class="rounded-md bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{{ k|capitalize }} <span class="font-semibold text-slate-900">{{ v }}</span></span>
                                                    {% endfor %}
                                                </div>
                                                <p class="t-label mb-1">Recommended answers</p>
                                                <ol class="space-y-1 list-decimal list-inside text-sm text-slate-800">
                                                    <li><span class="text-slate-500">Ad placement:</span> <span class="font-semibold">{{ neg.answers.car_spot }}</span></li>
                                                    <li><span class="text-slate-500">Next-season expectation:</span> <span class="font-semibold">{{ neg.answers.expectation }}</span></li>
                                                    <li><span class="text-slate-500">Driver popularity:</span> <span class="font-semibold">{{ neg.answers.driver_popularity }}</span></li>
                                                    <li><span class="text-slate-500">Amount per race:</span> <span class="font-semibold">{{ neg.answers.amount }}</span></li>
                                                    <li><span class="text-slate-500">Contract duration:</span> <span class="font-semibold">{{ neg.answers.duration }}</span></li>
                                                </ol>
                                            </div>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}

                    {% if training_baseline_count is defined %}
                        {% embed 'partials/_acc.twig' with {
                            id: 'training',
                            variant: 'row',
                            title: 'Training picks',
                            caption: training_division ? 'vs ' ~ training_division ~ ' ideal' : '',
                            training_picks: training_picks|default(null),
                            training_verdict: training_verdict,
                        } only %}
                            {% block verdict %}
                                {% if training_verdict %}
                                    <span class="text-xs font-semibold text-slate-700 tabular-nums">{{ training_verdict }}</span>
                                {% else %}
                                    <span class="text-xs font-semibold text-slate-500">No baseline yet</span>
                                {% endif %}
                            {% endblock %}
                            {% block body %}
                                <div class="space-y-3">
                                    {% if training_picks is not empty %}
                                        {# Rank, not the internal score: picks that help equally share a rank. #}
                                        {% set ranked_scores = training_picks|map(p => p.score)|reduce((seen, v) => v in seen ? seen : seen|merge([v]), []) %}
                                        {% set rank_labels = {1: 'Best', 2: 'Next best', 3: 'Third'} %}
                                        <ul class="space-y-2">
                                            {% for t in training_picks %}
                                                {% set rank = 0 %}
                                                {% for i, v in ranked_scores %}{% if v == t.score %}{% set rank = i + 1 %}{% endif %}{% endfor %}
                                                <li class="flex items-baseline justify-between gap-3 rounded-md border border-slate-200 px-3 py-2">
                                                    <div class="min-w-0">
                                                        <span class="text-sm font-semibold text-slate-900">{{ t.name }}</span>
                                                        <span class="t-caption ml-1">${{ t.cost|number_format }}</span>
                                                        <div class="t-caption mt-0.5 truncate">
                                                            {% for attr, g in t.gains %}
                                                                <span>{{ g > 0 ? '+' : '' }}{{ g }} {{ attr|replace({'_': ' '}) }}</span>{% if not loop.last %} · {% endif %}
                                                            {% endfor %}
                                                            {% if t.name == 'Spa' %}<span> · +energy</span>{% endif %}
                                                        </div>
                                                    </div>
                                                    {% if t.score > 0 %}
                                                        <span class="shrink-0 rounded-md px-1.5 py-0.5 text-xs font-semibold {{ rank == 1 ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' }}">{{ rank_labels[rank]|default('#' ~ rank) }}</span>
                                                    {% else %}
                                                        <span class="shrink-0 text-xs text-slate-400">No gain</span>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        {% embed 'partials/_how.twig' %}{% block how %}
                                            <p>Picks are ranked by how much closer each brings your driver to the division's ideal profile, weighted by what matters most in recruitment. Picks that help equally share a rank.</p>
                                        {% endblock %}{% endembed %}
                                    {% else %}
                                        <p class="text-sm text-slate-600">Not enough division baseline data yet.</p>
                                        {# The baseline is maintained by admins; a manager can't add to it. #}
                                        {% if user.is_admin %}
                                            <p class="t-caption">
                                                Add drivers in <a href="/divisions/baseline" class="underline">Division Baseline</a>
                                                to unlock training picks tuned to this division's ideal driver.
                                            </p>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}

                    {# GPRO pays per qualifying session done early (from season 113).
                       A plain row: it opens itself only while the bonus is shrinking
                       and a session is known to be outstanding. #}
                    {% if quali_bonus is defined and quali_bonus is not null %}
                        {% embed 'partials/_acc.twig' with {
                            id: 'quali-bonus',
                            variant: 'row',
                            title: 'Early qualifying bonus',
                            caption: quali_bonus.division ~ ' · $' ~ quali_bonus.per_session|number_format ~ ' per session',
                            open_default: quali_bonus.state == 'shrinking' and quali_bonus.sessions is not null,
                            b: quali_bonus,
                        } only %}
                            {% block verdict %}
                                {% import 'partials/_localtime.twig' as t %}
                                {% if b.state == 'preview' %}
                                    <span class="text-xs font-semibold text-slate-700">New from season {{ b.first_season }}</span>
                                {% elseif b.state == 'banked' %}
                                    <span class="text-xs font-semibold text-slate-700">Both sessions done</span>
                                {% elseif b.state == 'full' %}
                                    <span class="text-xs font-semibold text-slate-700">Full bonus until {{ t.localtime(b.full_until, 'weekday') }}</span>
                                {% else %}
                                    <span class="text-xs font-semibold text-amber-700">Shrinking · qualify soon</span>
                                {% endif %}
                            {% endblock %}
                            {% block body %}
                                {% import 'partials/_localtime.twig' as t %}
                                <div class="space-y-3 text-sm text-slate-700">
                                    {% if b.state == 'preview' %}
                                        <p>From season {{ b.first_season }}, GPRO pays a bonus for each qualifying session finished early: <span class="font-semibold text-slate-900">${{ b.per_session|number_format }} per session</span> in {{ b.division }}, paid with the race income.</p>
                                        <p>Qualify at least 24 hours before the race for the full amount. After that it falls steadily and is gone when qualifying closes; 12 hours out still pays about half.</p>
                                    {% else %}
                                        {% if b.sessions is not null %}
                                            <div class="grid grid-cols-2 gap-3">
                                                {% for key, label in {q1: 'Q1', q2: 'Q2'} %}
                                                    <div class="rounded-lg border border-slate-200 p-3 text-center">
                                                        <p class="t-label">{{ label }}</p>
                                                        <p class="t-value mt-1">{{ b.sessions[key] ? 'Done' : 'Not yet' }}</p>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                        {% if b.state == 'shrinking' %}
                                            <p>Worth about <span class="font-semibold text-slate-900">${{ b.now_per_session|number_format }} per session</span> now, and nothing once qualifying closes at {{ t.localtime(b.closes_at, 'weekday') }}.</p>
                                        {% elseif b.state == 'full' %}
                                            <p>Each session done by {{ t.localtime(b.full_until, 'weekday') }} pays the full ${{ b.per_session|number_format }}. After that it shrinks, down to nothing when qualifying closes at {{ t.localtime(b.closes_at, 'weekday') }}.</p>
                                        {% else %}
                                            <p>Both sessions are done; the bonus comes with the race income.</p>
                                        {% endif %}
                                        {% if b.sessions is null %}
                                            <p class="t-caption">Re-sync after qualifying to see which sessions GPRO has counted.</p>
                                        {% endif %}
                                    {% endif %}
                                    {% if b.state != 'banked' %}
                                        <p class="t-caption">Waiting on a new driver? The staff market runs about 24 hours before the race, so qualifying soon after it still earns almost the full bonus.</p>
                                    {% endif %}
                                </div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}

                </div>
            </section>
        </div>

        {# SEASON CALENDAR — one row per round with that track's P/H/A demand.
           No car-vs-track verdict here by design: the PHA card above already
           answers that for the next race. #}
        {% if season_calendar is defined and season_calendar is not empty %}
            {% embed 'partials/_acc.twig' with {
                id: 'calendar',
                title: 'Season calendar',
                caption: 'Each round and what that track demands.',
                season_calendar: season_calendar,
            } only %}
                {% block verdict %}
                    <span class="t-caption tabular-nums">{{ season_calendar|length }} rounds</span>
                {% endblock %}
                {% block body %}
                    <div class="dt-scroll">
                        <table class="dt">
                            <caption class="sr-only">Season calendar with each track's Power, Handling and Acceleration demand</caption>
                            <thead class="border-b border-slate-200">
                                <tr>
                                    <th scope="col" class="dt-th text-right">#</th>
                                    <th scope="col" class="dt-th">Track</th>
                                    <th scope="col" class="dt-th text-right">P</th>
                                    <th scope="col" class="dt-th text-right">H</th>
                                    <th scope="col" class="dt-th text-right">A</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for round in season_calendar %}
                                    <tr class="{{ round.is_current ? 'bg-slate-100 font-semibold' : '' }}">
                                        <td class="dt-td text-right text-slate-500">
                                            {{ round.race }}
                                            {%- if round.is_current %} <span class="text-xs font-semibold text-slate-900">next</span>{% endif -%}
                                        </td>
                                        <td class="dt-td whitespace-normal text-slate-900">
                                            {{ round.track_name|default('—') }}
                                        </td>
                                        <td class="dt-td text-right">{{ round.power is null ? '—' : round.power }}</td>
                                        <td class="dt-td text-right">{{ round.handling is null ? '—' : round.handling }}</td>
                                        <td class="dt-td text-right">{{ round.acceleration is null ? '—' : round.acceleration }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="t-caption mt-3">Higher means the track demands more of that attribute.</p>
                {% endblock %}
            {% endembed %}
        {% endif %}

        {# JUMP TO STRATEGY #}
        <div class="text-center">
            <a href="/strategy?track={{ active_track|url_encode }}"
               class="btn btn-md btn-primary">
                Set your race strategy →
            </a>
        </div>

    {% endif %}
</div>

<script>
(() => {
    const card = document.getElementById('wear');
    if (!card) return;

    // Live plan summary. Mirrors PhaMatchService::alignmentScore() and
    // ::matchLevel() so the "car after plan" row tracks the radios without a
    // round-trip; the server renders the same numbers for the default plan, so
    // the panel is already correct before this ever runs.
    const money = (n) => '$' + Math.round(n).toLocaleString('en-US');
    const ranks = (v) => v.map((x) => 1 + v.filter((y) => y > x).length);
    const topSet = (r) => r.reduce((acc, x, i) => (x === 1 ? [...acc, i] : acc), []);
    const matchLevel = (t, c) => {
        const tr = ranks(t);
        const cr = ranks(c);
        if (tr.every((x, i) => x === cr[i])) return 'Perfect match';
        const tt = topSet(tr);
        const ct = topSet(cr);
        if (tt.length === 1 && ct.length === 1 && tt[0] === ct[0]) return 'Top match';
        return 'No match';
    };
    const fitScore = (t, c) => {
        const ts = t.reduce((a, b) => a + b, 0);
        const cs = c.reduce((a, b) => a + b, 0);
        if (ts <= 0 || cs <= 0) return 0;
        let d = 0;
        for (let i = 0; i < 3; i++) d += Math.abs(t[i] / ts - c[i] / cs);
        return 100 * (1 - d / 2);
    };
    const recalcPlan = () => {
        const panel = card.querySelector('[data-plan-summary]');
        if (!panel) return;
        const num = (el, key) => Number(el.dataset[key]) || 0;
        const track = [num(panel, 'trackP'), num(panel, 'trackH'), num(panel, 'trackA')];
        const after = [num(panel, 'baseP'), num(panel, 'baseH'), num(panel, 'baseA')];
        let cost = 0;
        card.querySelectorAll('[data-plan-option]:checked').forEach((el) => {
            cost += Number(el.dataset.planCost) || 0;
            after[0] += Number(el.dataset.planDp) || 0;
            after[1] += Number(el.dataset.planDh) || 0;
            after[2] += Number(el.dataset.planDa) || 0;
        });
        const set = (sel, text) => {
            const el = panel.querySelector(sel);
            if (el) el.textContent = text;
        };
        set('[data-plan-after-p]', Math.round(after[0]));
        set('[data-plan-after-h]', Math.round(after[1]));
        set('[data-plan-after-a]', Math.round(after[2]));
        set('[data-plan-after-match]', matchLevel(track, after));
        set('[data-plan-after-fit]', Math.round(fitScore(track, after)));
        set('[data-plan-total]', money(cost));
        const over = panel.querySelector('[data-plan-over-cash]');
        if (over) over.classList.toggle('hidden', cost <= num(panel, 'cash'));
    };
    card.addEventListener('change', (e) => {
        if (e.target.matches('[data-plan-option]')) recalcPlan();
    });

    let pending = null;
    card.addEventListener('input', (e) => {
        if (!e.target.matches('[data-cockpit-wear-slider]')) return;
        // The readout sits next to its own slider, so scope the lookup to that
        // row — a card-wide query would drive every slider's label from one.
        const label = e.target.parentElement.querySelector('[data-slider-value]');
        if (label) label.textContent = e.target.value;
    });
    card.addEventListener('change', async (e) => {
        if (!e.target.matches('[data-cockpit-wear-slider]')) return;
        const form = e.target.form;
        if (!form) return;
        if (pending) pending.abort();
        pending = new AbortController();
        const params = new URLSearchParams(new FormData(form));
        params.set('fragment', 'cockpit_wear');
        // NEVER build this URL from form.action. On <form action=""> that
        // property resolves to the whole document URL -- query string and
        // #hash included -- so '?' + params appended to it yields a second
        // '?', and once a #wear anchor is in the address bar every appended
        // parameter lands inside the fragment, which browsers do not send.
        // The request then arrives without fragment=cockpit_wear, the server
        // answers with the full page, recover() appends the same garbage
        // again, and the address bar grows one ?...#wear segment per slider
        // move while the sliders silently stop reaching the server. Rebuilding
        // from the URL API replaces the query outright, so it cannot compound.
        const at = (search, hash) => {
            const u = new URL(window.location.href);
            u.search = search;
            u.hash = hash;
            return u.toString();
        };
        const url = at(params.toString(), '');
        const opts = { signal: pending.signal, headers: { 'X-Requested-With': 'fetch' } };
        // Last resort: re-enter the page carrying the settings the user chose
        // (and anchored on the wear card) so a recovery never silently rewinds
        // the sliders to zero and throws the reader back to the top.
        const recover = () => {
            const next = new URLSearchParams(params);
            next.delete('fragment');
            window.location.replace(at(next.toString(), 'wear'));
        };
        const lapsed = (r) => r.redirected || r.status === 401 || r.status === 403;
        try {
            let res = await fetch(url, opts);
            // An auth-shaped answer means the session lapsed mid-page. That very
            // request re-establishes it from the remember-me cookie, so a single
            // retry normally lands — cheaper than a full page load.
            if (lapsed(res)) {
                res = await fetch(url, opts);
            }
            if (lapsed(res)) {
                recover();
                return;
            }
            if (!res.ok) return;
            const html = await res.text();
            // A whole document here means something other than the fragment
            // endpoint answered — never nest it inside the card.
            if (/<!doctype/i.test(html)) {
                recover();
                return;
            }
            card.innerHTML = html;
            window.applyAccState(card);
            recalcPlan();
        } catch (err) {
            if (err.name !== 'AbortError') console.error(err);
        }
    });
})();
</script>
